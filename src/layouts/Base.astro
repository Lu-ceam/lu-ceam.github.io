---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';

interface Props {
	title?: string;
	description?: string;
	searchable?: boolean;
	ogType?: 'website' | 'article';
	published?: string;
	robots?: string;
}

const {
	title,
	description = siteConfig.description,
	searchable = false,
	ogType = 'website',
	published,
	robots,
} = Astro.props;

const documentTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
---

<!doctype html>
<html lang={siteConfig.lang} data-pagefind-ignore={searchable ? undefined : 'all'}>
	<head>
		<script is:inline>
			(function () {
				try {
					var theme = localStorage.getItem('theme');
					if (theme === 'light' || theme === 'dark') {
						document.documentElement.setAttribute('data-theme', theme);
					}
				} catch (error) {
					/* keep the system preference */
				}
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{documentTitle}</title>
		<meta name="description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		{robots !== 'noindex' && <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		{robots !== 'noindex' && <meta property="og:url" content={canonical} />}
		<meta property="og:locale" content="zh_CN" />
		{published && <meta property="article:published_time" content={published} />}
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip" href="#main">跳到正文</a>
		<Header pathname={Astro.url.pathname} />
		<main id="main" class="column" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var button = document.getElementById('theme-toggle');
				if (!button) return;

				function explicitTheme() {
					var value = root.getAttribute('data-theme');
					return value === 'light' || value === 'dark' ? value : null;
				}

				function currentTheme() {
					return (
						explicitTheme() ||
						(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
					);
				}

				function refresh() {
					var nextLabel = currentTheme() === 'dark' ? '浅色' : '深色';
					button.textContent = nextLabel;
					button.setAttribute('aria-label', '切换为' + nextLabel + '模式');
				}

				button.addEventListener('click', function () {
					var next = currentTheme() === 'dark' ? 'light' : 'dark';
					root.setAttribute('data-theme', next);
					try {
						localStorage.setItem('theme', next);
					} catch (error) {
						/* the choice simply will not be remembered */
					}
					refresh();
				});

				window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
					if (!explicitTheme()) refresh();
				});

				refresh();
			})();
		</script>
	</body>
</html>
