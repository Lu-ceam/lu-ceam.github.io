---
import Base from '../../layouts/Base.astro';
import {
	badgeCenter,
	detailMode,
	notesAligned,
	paintSide,
	showDetailsNote,
	showMarkLabel,
	visibleDetailText,
} from '../../data/detail-display';
import {
	badgeClass,
	heroAlt,
	records,
	storyParagraphs,
	showMatrix,
	showPressing,
	type VinylRecord,
} from '../../data/records';

export function getStaticPaths() {
	return records.map((record) => ({
		params: { id: record.id },
		props: { record },
	}));
}

const { record } = Astro.props as { record: VinylRecord };
const title = `${record.work} · ${record.catalogNumber}`;
const when = record.year ?? record.decade;
const revealDetails = record.details.filter((d) => detailMode(d) === 'reveal');
const hasRevealChapters = revealDetails.length > 0;
const nonRevealDetails = record.details.filter((d) => detailMode(d) !== 'reveal');
---

<Base title={title} description={record.photo} wide>
	<article
		class:list={['record-page', hasRevealChapters && 'record-page--scrub']}
		data-record-id={record.id}
	>
		<p class="record-back">
			<a href="/records/">← 目录</a>
		</p>
		{
			hasRevealChapters && (
				<>
					<header class="record-tombstone">
						<h1>{record.work}</h1>
						<p class="record-tombstone-meta">
							<span>{record.artist}</span>
							<span aria-hidden="true"> · </span>
							<span>{record.label}</span>
							<span aria-hidden="true"> · </span>
							<span>{record.catalogNumber}</span>
							<span aria-hidden="true"> · </span>
							<span>{when}</span>
							<span class={badgeClass(record.status)}>{record.status}</span>
						</p>
					</header>
					{
						revealDetails.map((detail) => {
							const aligned = notesAligned(detail);
							const remainder = visibleDetailText(detail);
							const sides = new Set(detail.marks.map((mark) => paintSide(mark.side)));
							return (
								<section
									class="reveal-runway"
									data-part={detail.part}
									data-plate-width={detail.plate.width}
									data-plate-height={detail.plate.height}
									data-notes={aligned ? 'aligned' : 'open'}
									style="--runway-vh: 2.75;"
								>
									<div
										class="reveal-stage"
										style={`--plate-w: ${detail.plate.width}; --plate-h: ${detail.plate.height};`}
									>
										{aligned && sides.has('left') && <div class="mark-slot mark-slot-left" />}
										<div class="plate-frame">
											<img
												class="plate"
												src={detail.plate.src}
												width={detail.plate.width}
												height={detail.plate.height}
												alt={detail.alt}
												decoding="async"
												loading="lazy"
											/>
											{detail.upright && detail.transform && (
												<div class="upright-clip">
													<img
														class="upright"
														src={detail.upright.src}
														width={detail.upright.width}
														height={detail.upright.height}
														alt=""
														aria-hidden="true"
														decoding="async"
														loading="lazy"
														data-crop-x={detail.transform.crop.x}
														data-crop-y={detail.transform.crop.y}
														data-crop-w={detail.transform.crop.w}
														data-crop-h={detail.transform.crop.h}
													/>
												</div>
											)}
											{detail.marks.length > 0 && (
												<svg
													class="plate-overlay"
													viewBox={`0 0 ${detail.plate.width} ${detail.plate.height}`}
													overflow="visible"
													aria-hidden="true"
												>
													<g class="mark-graphics">
														{detail.marks.map((mark, index) => {
															const badge = badgeCenter(mark, detail.plate.width);
															return (
																<g class="mark-callout" data-mark-id={mark.id}>
																	<rect
																		class="mark-box"
																		x={mark.x}
																		y={mark.y}
																		width={mark.w}
																		height={mark.h}
																		stroke-width="2"
																	/>
																	<circle
																		class="mark-disc"
																		cx={badge.cx}
																		cy={badge.cy}
																		r={badge.r}
																		stroke-width="2"
																	/>
																	<text
																		class="mark-num"
																		x={badge.cx}
																		y={badge.cy}
																		font-size={badge.fontSize}
																	>
																		{index + 1}
																	</text>
																</g>
															);
														})}
													</g>
													{aligned && (
														<g class="mark-leaders">
															{detail.marks.map((mark) => {
																const side = paintSide(mark.side);
																const x1 = side === 'left' ? mark.x : mark.x + mark.w;
																const y1 = mark.y + mark.h / 2;
																const x2 = side === 'left' ? 0 : detail.plate.width;
																return (
																	<line
																		class="mark-leader"
																		data-mark-id={mark.id}
																		x1={x1}
																		y1={y1}
																		x2={x2}
																		y2={y1}
																		stroke-width="1"
																	/>
																);
															})}
														</g>
													)}
												</svg>
											)}
											{aligned && (
												<ol class="mark-list" aria-label="题铭">
													{detail.marks.map((mark, index) => (
														<li
															id={`${record.id}-${detail.part}-mark-${mark.id}`}
															data-mark-id={mark.id}
															data-index={index}
															data-side={paintSide(mark.side)}
															data-side-pref={mark.side}
															data-x={mark.x}
															data-y={mark.y}
															data-w={mark.w}
															data-h={mark.h}
														>
															<span class="mark-index">{index + 1}</span>
															{showMarkLabel(mark) && <p class="mark-label">{mark.label}</p>}
															<p class="mark-note">{mark.note}</p>
														</li>
													))}
												</ol>
											)}
										</div>
										{aligned && sides.has('right') && <div class="mark-slot mark-slot-right" />}
										<div class="reveal-readout">
											<p class="reveal-caption">{detail.caption}</p>
											{remainder && <p class="detail-text">{remainder}</p>}
										</div>
									</div>
								</section>
							);
						})
					}
					<div class="record-after">
						{
							nonRevealDetails.length > 0 && (
								<div class="detail-grid">
									{
										nonRevealDetails.map((detail) => {
											const mode = detailMode(detail);
											const aligned = notesAligned(detail);
											const remainder = visibleDetailText(detail);
											const sides = new Set(detail.marks.map((mark) => paintSide(mark.side)));
											return (
												<figure
													class:list={[
														'detail-figure',
														mode === 'reveal' && 'is-reveal',
														mode !== 'legacy' && 'has-stage',
													]}
													data-part={detail.part}
													data-mode={mode}
													data-plate-width={detail.plate.width}
													data-plate-height={detail.plate.height}
													data-notes={aligned ? 'aligned' : 'open'}
												>
													{mode === 'legacy' ? (
														<img
															src={detail.plate.src}
															width={detail.plate.width}
															height={detail.plate.height}
															alt={detail.alt}
															decoding="async"
															loading="lazy"
														/>
													) : (
														<div class="detail-stage">
															{aligned && sides.has('left') && <div class="mark-slot mark-slot-left" />}
															<div class="plate-frame">
																<img
																	class="plate"
																	src={detail.plate.src}
																	width={detail.plate.width}
																	height={detail.plate.height}
																	alt={detail.alt}
																	decoding="async"
																	loading="lazy"
																/>
																{detail.marks.length > 0 && (
																	<svg
																		class="plate-overlay"
																		viewBox={`0 0 ${detail.plate.width} ${detail.plate.height}`}
																		overflow="visible"
																		aria-hidden="true"
																	>
																		<g class="mark-graphics">
																			{detail.marks.map((mark, index) => {
																				const badge = badgeCenter(mark, detail.plate.width);
																				return (
																					<g class="mark-callout" data-mark-id={mark.id}>
																						<rect
																							class="mark-box"
																							x={mark.x}
																							y={mark.y}
																							width={mark.w}
																							height={mark.h}
																							stroke-width="2"
																						/>
																						<circle
																							class="mark-disc"
																							cx={badge.cx}
																							cy={badge.cy}
																							r={badge.r}
																							stroke-width="2"
																						/>
																						<text
																							class="mark-num"
																							x={badge.cx}
																							y={badge.cy}
																							font-size={badge.fontSize}
																						>
																							{index + 1}
																						</text>
																					</g>
																				);
																			})}
																		</g>
																		{aligned && (
																			<g class="mark-leaders">
																				{detail.marks.map((mark) => {
																					const side = paintSide(mark.side);
																					const x1 = side === 'left' ? mark.x : mark.x + mark.w;
																					const y1 = mark.y + mark.h / 2;
																					const x2 = side === 'left' ? 0 : detail.plate.width;
																					return (
																						<line
																							class="mark-leader"
																							data-mark-id={mark.id}
																							x1={x1}
																							y1={y1}
																							x2={x2}
																							y2={y1}
																							stroke-width="1"
																						/>
																					);
																				})}
																			</g>
																		)}
																	</svg>
																)}
																{aligned && (
																	<ol class="mark-list" aria-label="题铭">
																		{detail.marks.map((mark, index) => (
																			<li
																				id={`${record.id}-${detail.part}-mark-${mark.id}`}
																				data-mark-id={mark.id}
																				data-index={index}
																				data-side={paintSide(mark.side)}
																				data-side-pref={mark.side}
																				data-x={mark.x}
																				data-y={mark.y}
																				data-w={mark.w}
																				data-h={mark.h}
																			>
																				<span class="mark-index">{index + 1}</span>
																				{showMarkLabel(mark) && <p class="mark-label">{mark.label}</p>}
																				<p class="mark-note">{mark.note}</p>
																			</li>
																		))}
																	</ol>
																)}
															</div>
															{aligned && sides.has('right') && <div class="mark-slot mark-slot-right" />}
														</div>
													)}
													<figcaption>{detail.caption}</figcaption>
													{remainder && <p class="detail-text">{remainder}</p>}
												</figure>
											);
										})
									}
								</div>
							)
						}
						<div class="record-text">
						<div class="record-story" lang="zh-Hans">
							{
								storyParagraphs(record.story).map((paragraph) => (
									<p>
										{paragraph.lead !== null && (
											<strong class="record-story-lead">{paragraph.lead}</strong>
										)}{paragraph.body}
									</p>
								))
							}
						</div>
						<dl class="props" aria-label="著录">
							<dt>艺人</dt>
							<dd>{record.artist}</dd>
							<dt>作曲家</dt>
							<dd>{record.composer}</dd>
							<dt>作品</dt>
							<dd>{record.work}</dd>
							<dt>厂牌</dt>
							<dd>{record.label}</dd>
							<dt>目录号</dt>
							<dd>{record.catalogNumber}</dd>
							{
								showMatrix(record) && record.matrix && (
									<>
										<dt>内圈刻字</dt>
										<dd>{record.matrix}</dd>
									</>
								)
							}
							{
								showPressing(record) && record.pressing && (
									<>
										<dt>压片</dt>
										<dd>{record.pressing}</dd>
									</>
								)
							}
							<dt>录音</dt>
							<dd>{record.recording}</dd>
							<dt>品相</dt>
							<dd>{record.condition}</dd>
							<dt>均衡</dt>
							<dd>{record.eq}</dd>
							<dt>状态</dt>
							<dd>{record.status}</dd>
							{
								record.year !== undefined && (
									<>
										<dt>年份</dt>
										<dd>{record.year}</dd>
									</>
								)
							}
						</dl>
						<details class="fold">
							<summary>出处</summary>
							<ul class="link-cards">
								{
									record.links.map((link) => (
										<li>
											<a href={link.href} target="_blank" rel="noopener noreferrer">
												<span class="link-title">{link.title}</span>
												<span class="link-site">{link.site}</span>
											</a>
										</li>
									))
								}
							</ul>
						</details>
						<details class="fold">
							<summary>证据核对</summary>
							<div class="fold-body">{record.evidence}</div>
						</details>
						<details class="fold">
							<summary>
								待补拍<span class="fold-lead"> · {record.needLead}</span>
							</summary>
							<div class="fold-body">{record.need}</div>
						</details>
						</div>
					</div>
				</>
			)
		}
		{
			!hasRevealChapters && (
			<div class="record-split">
				<div class="record-object">
					<figure class="entry-hero">
						<img
							src={record.image.src}
							width={record.image.width}
							height={record.image.height}
							alt={heroAlt(record)}
							decoding="async"
							fetchpriority="high"
						/>
						<figcaption>{record.photo}</figcaption>
					</figure>
					{
						showDetailsNote(record) && <p class="meta">{record.detailsNote}</p>
					}
					<div class="detail-grid">
						{
							record.details.map((detail) => {
								const mode = detailMode(detail);
								const aligned = notesAligned(detail);
								const remainder = visibleDetailText(detail);
								const sides = new Set(detail.marks.map((mark) => paintSide(mark.side)));
								return (
									<figure
										class:list={[
											'detail-figure',
											mode === 'reveal' && 'is-reveal',
											mode !== 'legacy' && 'has-stage',
										]}
										data-part={detail.part}
										data-mode={mode}
										data-plate-width={detail.plate.width}
										data-plate-height={detail.plate.height}
										data-notes={aligned ? 'aligned' : 'open'}
									>
										{mode === 'legacy' ? (
											<img
												src={detail.plate.src}
												width={detail.plate.width}
												height={detail.plate.height}
												alt={detail.alt}
												decoding="async"
												loading="lazy"
											/>
										) : (
											<div class="detail-stage">
												{aligned && sides.has('left') && <div class="mark-slot mark-slot-left" />}
												<div class="plate-frame">
													<img
														class="plate"
														src={detail.plate.src}
														width={detail.plate.width}
														height={detail.plate.height}
														alt={detail.alt}
														decoding="async"
														loading="lazy"
													/>
													{mode === 'reveal' && detail.upright && detail.transform && (
														<div class="upright-clip">
															<img
																class="upright"
																src={detail.upright.src}
																width={detail.upright.width}
																height={detail.upright.height}
																alt=""
																aria-hidden="true"
																decoding="async"
																loading="lazy"
																data-crop-x={detail.transform.crop.x}
																data-crop-y={detail.transform.crop.y}
																data-crop-w={detail.transform.crop.w}
																data-crop-h={detail.transform.crop.h}
															/>
														</div>
													)}
													{detail.marks.length > 0 && (
														<svg
															class="plate-overlay"
															viewBox={`0 0 ${detail.plate.width} ${detail.plate.height}`}
															overflow="visible"
															aria-hidden="true"
														>
															<g class="mark-graphics">
																{detail.marks.map((mark, index) => {
																	const badge = badgeCenter(mark, detail.plate.width);
																	return (
																		<g class="mark-callout" data-mark-id={mark.id}>
																			<rect
																				class="mark-box"
																				x={mark.x}
																				y={mark.y}
																				width={mark.w}
																				height={mark.h}
																				stroke-width="2"
																			/>
																			<circle
																				class="mark-disc"
																				cx={badge.cx}
																				cy={badge.cy}
																				r={badge.r}
																				stroke-width="2"
																			/>
																			<text
																				class="mark-num"
																				x={badge.cx}
																				y={badge.cy}
																				font-size={badge.fontSize}
																			>
																				{index + 1}
																			</text>
																		</g>
																	);
																})}
															</g>
															{aligned && (
																<g class="mark-leaders">
																	{detail.marks.map((mark) => {
																		const side = paintSide(mark.side);
																		const x1 = side === 'left' ? mark.x : mark.x + mark.w;
																		const y1 = mark.y + mark.h / 2;
																		const x2 = side === 'left' ? 0 : detail.plate.width;
																		return (
																			<line
																				class="mark-leader"
																				data-mark-id={mark.id}
																				x1={x1}
																				y1={y1}
																				x2={x2}
																				y2={y1}
																				stroke-width="1"
																			/>
																		);
																	})}
																</g>
															)}
														</svg>
													)}
													{aligned && (
														<ol class="mark-list" aria-label="题铭">
															{detail.marks.map((mark, index) => (
																<li
																	id={`${record.id}-${detail.part}-mark-${mark.id}`}
																	data-mark-id={mark.id}
																	data-index={index}
																	data-side={paintSide(mark.side)}
																	data-side-pref={mark.side}
																	data-x={mark.x}
																	data-y={mark.y}
																	data-w={mark.w}
																	data-h={mark.h}
																>
																	<span class="mark-index">{index + 1}</span>
																	{showMarkLabel(mark) && <p class="mark-label">{mark.label}</p>}
																	<p class="mark-note">{mark.note}</p>
																</li>
															))}
														</ol>
													)}
												</div>
												{aligned && sides.has('right') && <div class="mark-slot mark-slot-right" />}
											</div>
										)}
										<figcaption>{detail.caption}</figcaption>
										{remainder && <p class="detail-text">{remainder}</p>}
									</figure>
								);
							})
						}
					</div>
				</div>
				<div class="record-text">
					<header class="record-tombstone">
						<h1>{record.work}</h1>
						<p class="record-tombstone-meta">
							<span>{record.artist}</span>
							<span aria-hidden="true"> · </span>
							<span>{record.label}</span>
							<span aria-hidden="true"> · </span>
							<span>{record.catalogNumber}</span>
							<span aria-hidden="true"> · </span>
							<span>{when}</span>
							<span class={badgeClass(record.status)}>{record.status}</span>
						</p>
					</header>
					<div class="record-story" lang="zh-Hans">
						{
							storyParagraphs(record.story).map((paragraph) => (
								<p>
									{paragraph.lead !== null && (
										<strong class="record-story-lead">{paragraph.lead}</strong>
									)}{paragraph.body}
								</p>
							))
						}
					</div>
					<dl class="props" aria-label="著录">
						<dt>艺人</dt>
						<dd>{record.artist}</dd>
						<dt>作曲家</dt>
						<dd>{record.composer}</dd>
						<dt>作品</dt>
						<dd>{record.work}</dd>
						<dt>厂牌</dt>
						<dd>{record.label}</dd>
						<dt>目录号</dt>
						<dd>{record.catalogNumber}</dd>
						{
							showMatrix(record) && record.matrix && (
								<>
									<dt>内圈刻字</dt>
									<dd>{record.matrix}</dd>
								</>
							)
						}
						{
							showPressing(record) && record.pressing && (
								<>
									<dt>压片</dt>
									<dd>{record.pressing}</dd>
								</>
							)
						}
						<dt>录音</dt>
						<dd>{record.recording}</dd>
						<dt>品相</dt>
						<dd>{record.condition}</dd>
						<dt>均衡</dt>
						<dd>{record.eq}</dd>
						<dt>状态</dt>
						<dd>{record.status}</dd>
						{
							record.year !== undefined && (
								<>
									<dt>年份</dt>
									<dd>{record.year}</dd>
								</>
							)
						}
					</dl>
					<details class="fold">
						<summary>出处</summary>
						<ul class="link-cards">
							{
								record.links.map((link) => (
									<li>
										<a href={link.href} target="_blank" rel="noopener noreferrer">
											<span class="link-title">{link.title}</span>
											<span class="link-site">{link.site}</span>
										</a>
									</li>
								))
							}
						</ul>
					</details>
					<details class="fold">
						<summary>证据核对</summary>
						<div class="fold-body">{record.evidence}</div>
					</details>
					<details class="fold">
						<summary>
							待补拍<span class="fold-lead"> · {record.needLead}</span>
						</summary>
						<div class="fold-body">{record.need}</div>
					</details>
				</div>
			</div>
			)
		}
	</article>
	<script>
		import { leaderEndpoints, resolvedSide, stackTops } from '../../data/detail-display';
		import { chapterProgress, scrubVisual, uprightBox } from '../../data/scrub';

		function remPx(): number {
			return Number.parseFloat(getComputedStyle(document.documentElement).fontSize);
		}

		function ensureSlots(figure: HTMLElement): void {
			const stage = figure.querySelector<HTMLElement>('.detail-stage, .reveal-stage');
			const frame = figure.querySelector<HTMLElement>('.plate-frame');
			if (!stage || !frame) return;
			const sides = new Set(
				[...figure.querySelectorAll<HTMLLIElement>('.mark-list li')].map((li) => li.dataset.side),
			);
			for (const side of ['left', 'right'] as const) {
				const slot = stage.querySelector<HTMLElement>(`.mark-slot-${side}`);
				if (sides.has(side)) {
					if (!slot) {
						const created = document.createElement('div');
						created.className = `mark-slot mark-slot-${side}`;
						if (side === 'left') stage.insertBefore(created, frame);
						else stage.appendChild(created);
					}
				} else if (slot) {
					slot.remove();
				}
			}
		}

		function position(figure: HTMLElement): void {
			const plate = figure.querySelector<HTMLImageElement>('.plate');
			const list = figure.querySelector<HTMLOListElement>('.mark-list');
			if (!plate || !list) return;
			const plateWidth = Number(figure.dataset.plateWidth);
			const plateHeight = Number(figure.dataset.plateHeight);
			const items = [...list.querySelectorAll<HTMLLIElement>('li')];
			for (const li of items) {
				const pref = li.dataset.sidePref;
				const side = pref === 'left' || pref === 'right' || pref === 'auto' ? pref : 'auto';
				li.dataset.side = resolvedSide(
					{ side, x: Number(li.dataset.x), w: Number(li.dataset.w) },
					plateWidth,
				);
			}
			ensureSlots(figure);
			const gap = 0.35 * remPx();
			for (const side of ['left', 'right'] as const) {
				const group = items.filter((li) => li.dataset.side === side);
				const tops = stackTops(
					group.map((li) => ({
						index: Number(li.dataset.index),
						anchor: Number(li.dataset.y) + Number(li.dataset.h) / 2,
						height: li.offsetHeight,
					})),
					plateHeight,
					plate.clientHeight,
					gap,
				);
				group.forEach((li, index) => {
					const top = tops[index];
					if (top === undefined) return;
					li.style.top = `${top}px`;
				});
			}
			const plateRect = plate.getBoundingClientRect();
			const shortPx = 0.35 * remPx();
			for (const li of items) {
				const id = li.dataset.markId ?? '';
				const line = figure.querySelector<SVGLineElement>(
					`.mark-leader[data-mark-id="${CSS.escape(id)}"]`,
				);
				if (!line) continue;
				const side = li.dataset.side === 'left' ? 'left' : 'right';
				const points = leaderEndpoints({
					mark: {
						x: Number(li.dataset.x),
						y: Number(li.dataset.y),
						w: Number(li.dataset.w),
						h: Number(li.dataset.h),
					},
					side,
					plateRect: {
						left: plateRect.left,
						top: plateRect.top,
						width: plateRect.width,
						height: plateRect.height,
					},
					plateWidth,
					plateHeight,
					noteRect: li.getBoundingClientRect(),
					shortPx,
				});
				line.setAttribute('x1', String(points.x1));
				line.setAttribute('y1', String(points.y1));
				line.setAttribute('x2', String(points.x2));
				line.setAttribute('y2', String(points.y2));
			}
			const stage = figure.querySelector<HTMLElement>('.detail-stage, .reveal-stage');
			if (!stage) return;
			let overflow = 0;
			for (const li of items) {
				const bottom = li.offsetTop + li.offsetHeight;
				if (bottom > plate.clientHeight) overflow = Math.max(overflow, bottom - plate.clientHeight);
			}
			stage.style.paddingBottom = overflow > 0 ? `${overflow}px` : '';
		}

		function placeNotes(figure: HTMLElement): void {
			if (figure.dataset.notes !== 'aligned') return;
			try {
				position(figure);
			} catch {
				/* the plate stays readable without leaders */
			}
		}

		function applySettled(runway: HTMLElement): void {
			runway.classList.add('is-settled');
			const clip = runway.querySelector<HTMLElement>('.upright-clip');
			const upright = runway.querySelector<HTMLImageElement>('.upright');
			const plate = runway.querySelector<HTMLImageElement>('.plate');
			const graphics = runway.querySelector<SVGGElement>('.mark-graphics');
			const leaders = runway.querySelector<SVGGElement>('.mark-leaders');
			const notes = runway.querySelector<HTMLOListElement>('.mark-list');
			clip?.style.removeProperty('opacity');
			clip?.style.removeProperty('visibility');
			if (upright) {
				for (const prop of ['opacity', 'left', 'top', 'right', 'bottom', 'width', 'height', 'object-fit']) {
					upright.style.removeProperty(prop);
				}
			}
			plate?.style.removeProperty('opacity');
			graphics?.style.removeProperty('opacity');
			leaders?.style.removeProperty('opacity');
			notes?.style.removeProperty('opacity');
			placeNotes(runway);
		}

		function applyRunway(runway: HTMLElement): void {
			if (document.documentElement.dataset.motion !== 'ok') {
				applySettled(runway);
				return;
			}
			const upright = runway.querySelector<HTMLImageElement>('.upright');
			const plate = runway.querySelector<HTMLImageElement>('.plate');
			if (!upright || !plate) {
				applySettled(runway);
				return;
			}
			if (upright.naturalWidth === 0 || plate.clientWidth === 0 || plate.clientHeight === 0) return;
			const crop = {
				x: Number(upright.dataset.cropX),
				y: Number(upright.dataset.cropY),
				w: Number(upright.dataset.cropW),
				h: Number(upright.dataset.cropH),
			};
			if (![crop.x, crop.y, crop.w, crop.h].every((value) => Number.isFinite(value)) || crop.w <= 0) {
				applySettled(runway);
				return;
			}
			runway.classList.remove('is-settled');
			const visual = scrubVisual(chapterProgress(runway));
			const box = uprightBox(
				plate.clientWidth,
				plate.clientHeight,
				upright.naturalWidth,
				upright.naturalHeight,
				crop,
				visual.cropT,
			);
			const px = (value: number) => `${value}px`;
			upright.style.objectFit = 'fill';
			upright.style.right = 'auto';
			upright.style.bottom = 'auto';
			upright.style.left = px(box.left);
			upright.style.top = px(box.top);
			upright.style.width = px(box.width);
			upright.style.height = px(box.height);
			upright.style.opacity = String(visual.uprightOpacity);
			const clip = upright.parentElement;
			if (clip instanceof HTMLElement) {
				clip.style.opacity = String(visual.uprightOpacity);
				clip.style.visibility = visual.uprightOpacity > 0 ? 'visible' : 'hidden';
			}
			plate.style.opacity = String(visual.plateOpacity);
			const graphics = runway.querySelector<SVGGElement>('.mark-graphics');
			if (graphics) graphics.style.opacity = String(visual.boxesOpacity);
			const leaders = runway.querySelector<SVGGElement>('.mark-leaders');
			if (leaders) leaders.style.opacity = String(visual.boxesOpacity);
			const notes = runway.querySelector<HTMLOListElement>('.mark-list');
			if (notes) notes.style.opacity = String(visual.boxesOpacity);
		}

		function bindScrub(runways: HTMLElement[]): void {
			let ticking = false;
			const applyAll = () => {
				for (const runway of runways) {
					try {
						applyRunway(runway);
					} catch {
						applySettled(runway);
					}
				}
			};
			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					ticking = false;
					applyAll();
				});
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			for (const runway of runways) {
				const upright = runway.querySelector<HTMLImageElement>('.upright');
				if (!upright) continue;
				upright.addEventListener('load', applyAll);
				upright.addEventListener('error', () => applySettled(runway));
			}
			applyAll();
		}

		function init(): void {
			const figures = [...document.querySelectorAll<HTMLElement>('.detail-figure')];
			const runways = [...document.querySelectorAll<HTMLElement>('.reveal-runway')];
			let scrubBound = false;
			const reposition = () => {
				for (const figure of [...figures, ...runways]) {
					try {
						position(figure);
					} catch {
						/* keep the last placement */
					}
				}
			};
			for (const figure of figures) {
				try {
					position(figure);
				} catch {
					/* the figure still shows its plate */
				}
			}
			const enableScrub = () => {
				if (document.documentElement.dataset.motion !== 'ok') {
					for (const runway of runways) applySettled(runway);
					return;
				}
				if (!scrubBound) {
					scrubBound = true;
					bindScrub(runways);
				} else {
					for (const runway of runways) {
						try {
							applyRunway(runway);
						} catch {
							applySettled(runway);
						}
					}
				}
				reposition();
			};
			if (document.documentElement.dataset.motion === 'ok') enableScrub();
			else for (const runway of runways) applySettled(runway);
			window.addEventListener('resize', () => {
				reposition();
				if (document.documentElement.dataset.motion === 'ok') {
					for (const runway of runways) {
						try {
							applyRunway(runway);
						} catch {
							applySettled(runway);
						}
					}
				}
			});
			document.fonts?.ready.then(() => {
				reposition();
				if (document.documentElement.dataset.motion === 'ok') {
					for (const runway of runways) applyRunway(runway);
				}
			}).catch(() => {
				/* fonts.ready rejected; the first placement stands */
			});
			try {
				const media = window.matchMedia('(prefers-reduced-motion: reduce)');
				media.addEventListener('change', () => {
					document.documentElement.dataset.motion = media.matches ? 'reduce' : 'ok';
					if (media.matches) {
						for (const runway of runways) applySettled(runway);
					} else {
						enableScrub();
					}
				});
			} catch {
				/* head script already set data-motion, or left it unset */
			}
		}

		init();
	</script>
</Base>
