	</article>
	<script>
		import {
			leaderEndpoints,
			leaderHitsNote,
			LETTERBOX_BAND_RESERVE_REM,
			MIN_NOTE_REM,
			NOTE_CAP_REM,
			calloutsActive,
			cropWindow,
			fillCropPaint,
			layerTransform,
			openingBox,
			placeExpandedPanel,
			placeNotes,
			plateBox,
			resolvedSide,
			SCRIM_INSET_REM,
			stackTops,
			zoomImageBox,
		} from '../../data/detail-display';

		import { splitCalloutMode } from '../../data/callout-notes';
		import {
		leaderPathLength,
		leaderTerminusDashOffset,
		selectSplitLeaders,
	} from '../../data/split-leaders';
		import { hugSettledPlate } from '../../data/settled-pane';
		import { canLatchReading, readingScrollOnly, runwayProgress } from '../../data/reading-scroll';
		import { mountChapterReader } from '../../data/disc-chapter-reader';

		let chapterReader: ReturnType<typeof mountChapterReader> | null = null;

		import {
			COLLAPSE_SVH,
			DETAIL_CROSSFADE_MS,
			DISC_SETTLED_H_PX,
			JOINT_SVH,
			PASS_SVH,
			PLATE_END,
			SETTLED_COLLAPSE_T,
			SETTLED_EXIT_PX,
			SETTLE_EPSILON_PX,
			SETTLE_IDLE_MS,
			SETTLE_LOCK_MS,
			SETTLE_SLACK_PX,
			THUMB_HEIGHT_PX,
			collapseVisual,
			framePaintsContent,
			nearestSettlePlace,
			placeOnRunway,
			readTrackOffset,
			runwayScrollY,
			runwayTravelSvh,
			settledBarHeightPx,
			settledBarOn,
			settledCoverBoxPx,
			shouldSettleRunway,
			stageVisual,
			thumbHeightPx,
			type RunwayPlace,
		} from '../../data/split-stage';

		function remPx(): number {
			return Number.parseFloat(getComputedStyle(document.documentElement).fontSize);
		}

		function isNarrow(): boolean {
			return window.matchMedia('(max-width: 47.99rem)').matches;
		}

		function formatLeaderPoints(points: readonly { x: number; y: number }[]): string {
			return points.map((point) => `${point.x},${point.y}`).join(' ');
		}

		function fitLeaderMask(mask: SVGPolylineElement, points: readonly { x: number; y: number }[]): void {
			const owner = mask.parentElement;
			if (!(owner instanceof SVGMaskElement)) return;
			const xs = points.map((point) => point.x);
			const ys = points.map((point) => point.y);
			const pad = 8;
			const minX = Math.min(...xs) - pad;
			const minY = Math.min(...ys) - pad;
			const maxX = Math.max(...xs) + pad;
			const maxY = Math.max(...ys) + pad;
			owner.setAttribute('x', String(minX));
			owner.setAttribute('y', String(minY));
			owner.setAttribute('width', String(Math.max(0, maxX - minX)));
			owner.setAttribute('height', String(Math.max(0, maxY - minY)));
		}

		function openLeaderMasks(root: ParentNode): void {
			root.querySelectorAll<SVGPolylineElement>('.mark-leader-mask').forEach((mask) => {
				mask.removeAttribute('pathLength');
				mask.removeAttribute('stroke-dasharray');
				mask.removeAttribute('stroke-dashoffset');
			});
		}

		function writeSplitLeaders(
			figure: HTMLElement,
			items: readonly HTMLLIElement[],
			plate: HTMLImageElement,
			plateWidth: number,
			plateHeight: number,
		): void {
			const sentenceBounds = (li: HTMLElement): DOMRect => {
				const note = li.querySelector<HTMLElement>('.mark-note');
				if (!note) return li.getBoundingClientRect();
				const range = document.createRange();
				range.selectNodeContents(note);
				const rect = range.getBoundingClientRect();
				if (rect.width >= 1 && rect.height >= 1) return rect;
				return note.getBoundingClientRect();
			};
			const plateRect = plate.getBoundingClientRect();
			const scaleX = plateWidth === 0 ? 0 : plateRect.width / plateWidth;
			const scaleY = plateHeight === 0 ? 0 : plateRect.height / plateHeight;
			const inputs =
				scaleX <= 0 || scaleY <= 0
					? []
					: items.map((li) => {
							const noteRect = sentenceBounds(li);
							const pref = li.dataset.side === 'left' ? 'left' : 'right';
							return {
								index: Number(li.dataset.index),
								mark: {
									x: Number(li.dataset.x),
									y: Number(li.dataset.y),
									w: Number(li.dataset.w),
									h: Number(li.dataset.h),
								},
								side: pref,
								kind: li.dataset.kind === 'letterbox' ? 'letterbox' : 'side',
								note: {
									left: (noteRect.left - plateRect.left) / scaleX,
									right: (noteRect.right - plateRect.left) / scaleX,
									top: (noteRect.top - plateRect.top) / scaleY,
									bottom: (noteRect.bottom - plateRect.top) / scaleY,
								},
								omitLeader: li.dataset.omitLeader === '1',
							} as const;
						});
			const frameRect = figure.getBoundingClientRect();
			const visibleX =
				scaleX <= 0
					? undefined
					: {
							left: (frameRect.left - plateRect.left) / scaleX,
							right: (frameRect.right - plateRect.left) / scaleX,
					  };
			const chosen =
				scaleX <= 0 || scaleY <= 0 ? [] : selectSplitLeaders(inputs, { visibleX });
			for (const li of items) {
				const id = li.dataset.markId ?? '';
				const leader = figure.querySelector<SVGPolylineElement>(
					`.mark-leader[data-mark-id="${CSS.escape(id)}"]`,
				);
				const mask = figure.querySelector<SVGPolylineElement>(
					`.mark-leader-mask[data-mark-id="${CSS.escape(id)}"]`,
				);
				if (!leader) continue;
				const row = chosen.find((entry) => entry.index === Number(li.dataset.index));
				const points = row?.points ?? null;
				if (!points || points.length < 2) {
					leader.removeAttribute('points');
					leader.removeAttribute('stroke-dashoffset');
					mask?.removeAttribute('points');
					delete li.dataset.leaderEdge;
					continue;
				}
				const rendered = formatLeaderPoints(points);
				leader.setAttribute('points', rendered);
				leader.setAttribute(
					'stroke-dashoffset',
					String(leaderTerminusDashOffset(leaderPathLength(points))),
				);
				if (mask) {
					mask.setAttribute('points', rendered);
					fitLeaderMask(mask, points);
				}
				const input = inputs.find((entry) => entry.index === Number(li.dataset.index));
				const end = points.at(-1);
				if (input && end) {
					const toLeft = Math.abs(end.x - input.note.left);
					const toRight = Math.abs(end.x - input.note.right);
					li.dataset.leaderEdge = toLeft <= toRight ? 'left' : 'right';
				} else {
					delete li.dataset.leaderEdge;
				}
			}
			if (document.documentElement.dataset.motion !== 'ok') openLeaderMasks(figure);
		}

		function writeLeaders(
			figure: HTMLElement,
			items: readonly HTMLLIElement[],
			plate: HTMLImageElement,
			plateWidth: number,
			plateHeight: number,
		): void {
			if (figure.classList.contains('split-frame')) {
				writeSplitLeaders(figure, items, plate, plateWidth, plateHeight);
				return;
			}
			const plateRect = plate.getBoundingClientRect();
			const shortPx = 0.35 * remPx();
			for (const li of items) {
				const id = li.dataset.markId ?? '';
				const leader = figure.querySelector<SVGPolylineElement>(
					`.mark-leader[data-mark-id="${CSS.escape(id)}"]`,
				);
				const mask = figure.querySelector<SVGPolylineElement>(
					`.mark-leader-mask[data-mark-id="${CSS.escape(id)}"]`,
				);
				if (!leader) continue;
				const side = li.dataset.side === 'left' ? 'left' : 'right';
				const points = leaderEndpoints({
					mark: {
						x: Number(li.dataset.x),
						y: Number(li.dataset.y),
						w: Number(li.dataset.w),
						h: Number(li.dataset.h),
					},
					side,
					plateRect: {
						left: plateRect.left,
						top: plateRect.top,
						width: plateRect.width,
						height: plateRect.height,
					},
					plateWidth,
					plateHeight,
					noteRect: li.getBoundingClientRect(),
					shortPx,
				});
				const noteRect = li.getBoundingClientRect();
				const scaleX = plateRect.width / plateWidth;
				const scaleY = plateRect.height / plateHeight;
				const hits =
					li.dataset.omitLeader === '1' ||
					(scaleX > 0 &&
						scaleY > 0 &&
						leaderHitsNote(points, {
							left: (noteRect.left - plateRect.left) / scaleX,
							right: (noteRect.right - plateRect.left) / scaleX,
							top: (noteRect.top - plateRect.top) / scaleY,
							bottom: (noteRect.bottom - plateRect.top) / scaleY,
						}));
				if (points.length < 2 || hits) {
					leader.removeAttribute('points');
					leader.removeAttribute('stroke-dashoffset');
					mask?.removeAttribute('points');
					continue;
				}
				const rendered = formatLeaderPoints(points);
				leader.setAttribute('points', rendered);
				leader.setAttribute(
					'stroke-dashoffset',
					String(leaderTerminusDashOffset(leaderPathLength(points))),
				);
				if (mask) {
					mask.setAttribute('points', rendered);
					fitLeaderMask(mask, points);
				}
			}
			if (document.documentElement.dataset.motion !== 'ok') openLeaderMasks(figure);
		}

		function ensureSlots(figure: HTMLElement): void {
			if (figure.classList.contains('split-frame')) return;
			const stage = figure.querySelector<HTMLElement>('.detail-stage');
			const frame = figure.querySelector<HTMLElement>('.plate-frame');
			if (!stage || !frame) return;
			const sides = new Set(
				[...figure.querySelectorAll<HTMLLIElement>('.mark-list li')].map((li) => li.dataset.side),
			);
			for (const side of ['left', 'right'] as const) {
				const slot = stage.querySelector<HTMLElement>(`.mark-slot-${side}`);
				if (sides.has(side)) {
					if (!slot) {
						const created = document.createElement('div');
						created.className = `mark-slot mark-slot-${side}`;
						if (side === 'left') stage.insertBefore(created, frame);
						else stage.appendChild(created);
					}
				} else if (slot) {
					slot.remove();
				}
			}
		}

		function clearStageInline(stage: HTMLElement, frame: HTMLElement, items: readonly HTMLElement[]): void {
			frame.style.flex = '';
			frame.style.minWidth = '';
			frame.style.width = '';
			stage.querySelectorAll<HTMLElement>('.mark-slot').forEach((slot) => {
				slot.style.flex = '';
				slot.style.minWidth = '';
				slot.style.maxWidth = '';
				slot.style.width = '';
			});
			for (const li of items) li.style.maxWidth = '';
		}

		function stackNotes(
			items: readonly HTMLLIElement[],
			plate: HTMLImageElement,
			plateHeight: number,
			gapPx: number,
		): void {
			for (const side of ['left', 'right'] as const) {
				const group = items.filter((li) => li.dataset.side === side);
				const tops = stackTops(
					group.map((li) => ({
						index: Number(li.dataset.index),
						anchor: Number(li.dataset.y) + Number(li.dataset.h) / 2,
						height: li.offsetHeight,
					})),
					plateHeight,
					plate.clientHeight,
					gapPx,
				);
				group.forEach((li, index) => {
					const top = tops[index];
					if (top === undefined) return;
					li.style.top = `${top}px`;
				});
			}
		}

		function position(figure: HTMLElement): void {
			if (figure.classList.contains('split-frame')) {
				positionSplit(figure);
				return;
			}
			const plate = figure.querySelector<HTMLImageElement>('.plate');
			const list = figure.querySelector<HTMLOListElement>('.mark-list');
			if (!plate || !list) return;
			const plateWidth = Number(figure.dataset.plateWidth);
			const plateHeight = Number(figure.dataset.plateHeight);
			const items = [...list.querySelectorAll<HTMLLIElement>('li')];
			const stage = figure.querySelector<HTMLElement>('.detail-stage');
			const frame = figure.querySelector<HTMLElement>('.plate-frame');
			const root = remPx();
			for (const li of items) {
				const pref = li.dataset.sidePref;
				const sidePref = pref === 'left' || pref === 'right' || pref === 'auto' ? pref : 'auto';
				li.dataset.side = resolvedSide(
					{ side: sidePref, x: Number(li.dataset.x), w: Number(li.dataset.w) },
					plateWidth,
				);
			}
			ensureSlots(figure);
			if (stage && frame) clearStageInline(stage, frame, items);
			stackNotes(items, plate, plateHeight, 0.35 * root);
			if (stage) {
				let hang = 0;
				for (const li of items) {
					const bottom = li.offsetTop + li.offsetHeight;
					if (bottom > plate.clientHeight) hang = Math.max(hang, bottom - plate.clientHeight);
				}
				stage.style.paddingBottom = hang > 0 ? `${hang}px` : '';
			}
			writeLeaders(figure, items, plate, plateWidth, plateHeight);
		}

		let openOverflowId: string | null = null;

		function syncOverflowHit(li: HTMLLIElement, overflow: boolean): void {
			const sentence = li.querySelector<HTMLElement>('.mark-note');
			let button = li.querySelector<HTMLButtonElement>('.mark-hit');
			if (!overflow || !sentence) {
				button?.remove();
				return;
			}
			if (!button) {
				button = document.createElement('button');
				button.type = 'button';
				button.className = 'mark-hit';
				li.appendChild(button);
			}
			if (!sentence.id) sentence.id = `${li.id}-note`;
			button.setAttribute('aria-controls', sentence.id);
			button.setAttribute('aria-label', sentence.textContent?.replace(/\s+/g, ' ').trim() ?? '');
			if (button.getAttribute('aria-expanded') !== 'true') button.setAttribute('aria-expanded', 'false');
		}

		function refreshSplit(): void {
			const page = document.querySelector<HTMLElement>('.record-page--split');
			if (!page) return;
			for (const frame of page.querySelectorAll<HTMLElement>('.split-frame')) {
				if (frame.dataset.notes !== 'aligned') continue;
				try {
					position(frame);
					// 先盘后文: narrow imagery height is owned by reveal / collapse / thumb.
				} catch {
					/* keep the last placement */
				}
			}
		}

		function bindOverflow(list: HTMLOListElement): void {
			if (list.dataset.overflowBound === '1') return;
			list.dataset.overflowBound = '1';
			list.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;
				const button = target.closest('.mark-hit');
				if (!(button instanceof HTMLButtonElement)) return;
				const li = button.closest('li');
				if (!li?.id) return;
				openOverflowId = openOverflowId === li.id ? null : li.id;
				refreshSplit();
			});
		}

		function measureNoteWidth(figure: HTMLElement, plateWidthPx: number, rem: number): number {
			const strip = (figure.clientWidth - plateWidthPx) / 2;
			if (strip + 1e-6 >= MIN_NOTE_REM * rem) {
				return Math.min(NOTE_CAP_REM * rem, Math.max(0, strip));
			}
			return Math.min(NOTE_CAP_REM * rem, figure.clientWidth / 2);
		}

		function applyExpanded(
			figure: HTMLElement,
			items: readonly HTMLLIElement[],
			placed: readonly {
				index: number;
				kind: string;
				side: 'left' | 'right';
				left: number;
				top: number;
				width: number;
				height: number;
				omitLeader: boolean;
			}[],
			pose: { plate: { left: number; top: number; width: number; height: number } },
			plateWidth: number,
			plateHeight: number,
			root: number,
		): void {
			const drafts = items.map((li) => {
				const pref = li.dataset.sidePref;
				const sidePref = pref === 'left' || pref === 'right' || pref === 'auto' ? pref : 'auto';
				return {
					index: Number(li.dataset.index),
					side: resolvedSide(
						{ side: sidePref, x: Number(li.dataset.x), w: Number(li.dataset.w) },
						plateWidth,
					),
					anchor: Number(li.dataset.y) + Number(li.dataset.h) / 2,
					height: li.offsetHeight,
					mark: {
						x: Number(li.dataset.x),
						y: Number(li.dataset.y),
						w: Number(li.dataset.w),
						h: Number(li.dataset.h),
					},
				};
			});
			for (const li of items) {
				const button = li.querySelector<HTMLButtonElement>('.mark-hit');
				const open = li.id !== '' && li.id === openOverflowId && li.dataset.kind === 'overflow';
				if (!open) {
					li.removeAttribute('data-expanded');
					button?.setAttribute('aria-expanded', 'false');
					continue;
				}
				const place = placed.find((note) => note.index === Number(li.dataset.index));
				const sentence = li.querySelector<HTMLElement>('.mark-note');
				const note = drafts.find((item) => item.index === Number(li.dataset.index));
				if (!place || !sentence || !note || !isNarrow()) {
					openOverflowId = null;
					li.removeAttribute('data-expanded');
					button?.setAttribute('aria-expanded', 'false');
					continue;
				}
				const letterboxWidth = Math.min(NOTE_CAP_REM * root, figure.clientWidth / 2);
				const scrimWidth = Math.min(
					NOTE_CAP_REM * root,
					Math.max(0, pose.plate.width / 2 - SCRIM_INSET_REM * root),
				);
				sentence.style.display = 'block';
				sentence.style.position = 'absolute';
				sentence.style.padding = '0';
				sentence.style.width = `${letterboxWidth}px`;
				const letterboxHeight = sentence.offsetHeight;
				sentence.style.width = `${scrimWidth}px`;
				sentence.style.padding = '0.35rem 0.45rem';
				const scrimHeight = sentence.offsetHeight;
				const panel = placeExpandedPanel({
					pane: { width: figure.clientWidth, height: figure.clientHeight },
					plate: pose.plate,
					plateSize: { width: plateWidth, height: plateHeight },
					rem: root,
					note,
					notes: drafts,
					letterboxHeight,
					scrimHeight,
					occupied: placed
						.filter((item) => item.kind === 'side' || item.kind === 'letterbox')
						.map((item) => ({
							side: item.side,
							left: item.left,
							top: item.top,
							width: item.width,
							height: item.height,
						})),
				});
				li.setAttribute('data-expanded', 'true');
				li.classList.toggle('is-scrim', panel.kind === 'scrim');
				li.setAttribute('data-omit-leader', panel.omitLeader ? '1' : '0');
				sentence.style.left = `${panel.left - place.left}px`;
				sentence.style.top = `${panel.top - place.top}px`;
				sentence.style.width = `${panel.width}px`;
				sentence.style.padding = panel.kind === 'scrim' ? '' : '0';
				sentence.style.display = '';
				button?.setAttribute('aria-expanded', 'true');
			}
		}

		function positionSplit(figure: HTMLElement): void {
			const plate = figure.querySelector<HTMLImageElement>('.plate');
			const list = figure.querySelector<HTMLOListElement>('.mark-list');
			const stage = figure.querySelector<HTMLElement>('.detail-stage');
			if (!plate || !list) return;
			poseKey.delete(figure);
			const page = figure.closest<HTMLElement>('.record-page--split');
			page?.style.removeProperty('--imagery-h');
			figure.style.removeProperty('--imagery-h');
			delete figure.dataset.paneSettle;
			void figure.offsetHeight;
			const pose = layoutSplit(figure);
			if (!pose) return;
			if (stage) stage.style.paddingBottom = '';
			const plateWidth = Number(figure.dataset.plateWidth);
			const plateHeight = Number(figure.dataset.plateHeight);
			const items = [...list.querySelectorAll<HTMLLIElement>('li')];
			const root = remPx();
			const narrow = isNarrow();
			const measureWidth = measureNoteWidth(figure, pose.plate.width, root);
			for (const li of items) {
				delete li.dataset.kind;
				li.removeAttribute('data-expanded');
				li.classList.remove('is-scrim');
				li.querySelector('.mark-hit')?.remove();
				const sentence = li.querySelector<HTMLElement>('.mark-note');
				if (sentence) {
					sentence.style.left = '';
					sentence.style.top = '';
					sentence.style.width = '';
					sentence.style.position = '';
					sentence.style.padding = '';
					sentence.style.display = '';
				}
				li.style.width = `${measureWidth}px`;
			}
			void list.offsetHeight;
			const placed = placeNotes({
				pane: { width: figure.clientWidth, height: figure.clientHeight },
				plate: pose.plate,
				plateSize: { width: plateWidth, height: plateHeight },
				rem: root,
				narrow: isNarrow(),
				notes: items.map((li) => {
					const pref = li.dataset.sidePref;
					const sidePref = pref === 'left' || pref === 'right' || pref === 'auto' ? pref : 'auto';
					const sentence = li.querySelector<HTMLElement>('.mark-note');
					let glyph: { dx: number; dy: number; width: number; height: number } | undefined;
					if (sentence) {
						const range = document.createRange();
						range.selectNodeContents(sentence);
						const ink = range.getBoundingClientRect();
						const host = li.getBoundingClientRect();
						if (ink.width >= 1 && ink.height >= 1) {
							glyph = {
								dx: ink.left - host.left,
								dy: ink.top - host.top,
								width: ink.width,
								height: ink.height,
							};
						}
					}
					return {
						index: Number(li.dataset.index),
						side: resolvedSide(
							{ side: sidePref, x: Number(li.dataset.x), w: Number(li.dataset.w) },
							plateWidth,
						),
						anchor: Number(li.dataset.y) + Number(li.dataset.h) / 2,
						height: li.offsetHeight,
						...(glyph ? { glyph } : {}),
						mark: {
							x: Number(li.dataset.x),
							y: Number(li.dataset.y),
							w: Number(li.dataset.w),
							h: Number(li.dataset.h),
						},
					};
				}),
			});
			for (const li of items) {
				const place = placed.find((note) => note.index === Number(li.dataset.index));
				if (!place) continue;
				li.dataset.side = place.side;
				li.setAttribute('data-kind', place.kind);
				syncOverflowHit(li, place.kind === 'overflow');
				li.setAttribute('data-omit-leader', place.omitLeader ? '1' : '0');
				li.classList.toggle('is-scrim', place.kind === 'scrim');
				li.style.left = `${place.left - pose.plate.left}px`;
				li.style.right = 'auto';
				li.style.top = `${place.top - pose.plate.top}px`;
				li.style.bottom = 'auto';
				li.style.width = `${place.width}px`;
				li.style.maxWidth = 'none';
			}
			const strip = (figure.clientWidth - pose.plate.width) / 2;
			const mode = splitCalloutMode({
				narrow,
				stripPx: strip,
				rem: root,
				placements: placed,
			});
			if (mode === null) figure.removeAttribute('data-callout');
			else figure.setAttribute('data-callout', mode);
			figure.setAttribute('data-callouts', 'placed');
			bindOverflow(list);
			applyExpanded(figure, items, placed, pose, plateWidth, plateHeight, root);
			writeLeaders(figure, items, plate, plateWidth, plateHeight);
		}

		function settle(figure: HTMLElement): void {
			if (figure.dataset.settled === '1') return;
			figure.dataset.settled = '1';
			figure.classList.add('is-settled');
			figure.removeAttribute('tabindex');
			const upright = figure.querySelector<HTMLImageElement>('.upright');
			if (upright) upright.style.opacity = '';
			const plate = figure.querySelector<HTMLImageElement>('.plate');
			if (plate) plate.style.opacity = '';
			const leaders = figure.querySelector<SVGGElement>('.mark-leaders');
			if (leaders) leaders.style.opacity = '';
			openLeaderMasks(figure);
			try {
				position(figure);
			} catch {
				/* the settled plate is already on screen */
			}
		}

		type SplitPose = {
			opening: { left: number; top: number; width: number; height: number };
			plate: { left: number; top: number; width: number; height: number };
			natural: { width: number; height: number };
			crop: { x: number; y: number; w: number; h: number };
		};

		const tallPose = new WeakMap<HTMLElement, SplitPose>();
		const poseKey = new WeakMap<HTMLElement, string>();

		function layoutSplit(figure: HTMLElement): SplitPose | null {
			if (figure.dataset.paneSettle === '1') {
				return tallPose.get(figure) ?? null;
			}
			const key = `${window.innerWidth}x${window.innerHeight}x${isNarrow() ? 1 : 0}`;
			if (poseKey.get(figure) === key) {
				const cached = tallPose.get(figure);
				if (cached) return cached;
			}
			const upright = figure.querySelector<HTMLImageElement>('.upright');
			const plateImg = figure.querySelector<HTMLImageElement>('.plate');
			const plateFrame = figure.querySelector<HTMLElement>('.plate-frame');
			if (!upright || !plateImg || !plateFrame) return null;
			const naturalW = Number(upright.getAttribute('width'));
			const naturalH = Number(upright.getAttribute('height'));
			const paneW = figure.clientWidth;
			const paneH = figure.clientHeight;
			if (naturalW <= 0 || naturalH <= 0 || paneW <= 0 || paneH <= 0) return null;
			const natural = { width: naturalW, height: naturalH };
			const pane = { width: paneW, height: paneH };
			const crop = {
				x: Number(upright.dataset.cropX),
				y: Number(upright.dataset.cropY),
				w: Number(upright.dataset.cropW),
				h: Number(upright.dataset.cropH),
			};
			const opening = openingBox(pane, natural);
			const bandReservePx = isNarrow() ? LETTERBOX_BAND_RESERVE_REM * remPx() : 0;
			const plate = plateBox(
				pane,
				opening,
				{
					width: Number(figure.dataset.plateWidth),
					height: Number(figure.dataset.plateHeight),
				},
				natural,
				crop,
				bandReservePx,
			);
			if (plate.width <= 0 || plate.height <= 0) return null;
			plateFrame.style.left = `${plate.left}px`;
			plateFrame.style.top = `${plate.top}px`;
			plateFrame.style.right = 'auto';
			plateFrame.style.bottom = 'auto';
			plateFrame.style.width = `${plate.width}px`;
			plateFrame.style.height = `${plate.height}px`;
			plateFrame.style.maxWidth = 'none';
			plateFrame.style.maxHeight = 'none';
			plateFrame.style.transform = 'none';
			plateImg.style.width = '100%';
			plateImg.style.height = '100%';
			plateImg.style.maxWidth = 'none';
			plateImg.style.maxHeight = 'none';
			const pose: SplitPose = { opening, plate, natural, crop };
			poseKey.set(figure, key);
			tallPose.set(figure, pose);
			return pose;
		}

		function collapseToContent(figure: HTMLElement, mode: 'page' | 'frame'): void {
			if (!isNarrow()) return;
			const page = figure.closest<HTMLElement>('.record-page--split');
			const plateFrame = figure.querySelector<HTMLElement>('.plate-frame');
			const list = figure.querySelector<HTMLOListElement>('.mark-list');
			if (!page || !plateFrame || !list) return;
			const pad = 0.75 * remPx();
			const plateTop = Number.parseFloat(plateFrame.style.top);
			const plateHeight = Number.parseFloat(plateFrame.style.height);
			if (!Number.isFinite(plateTop) || !Number.isFinite(plateHeight)) return;
			const paneHeight = figure.clientHeight;
			const notes: { top: number; bottom: number }[] = [];
			for (const li of list.querySelectorAll<HTMLLIElement>('li')) {
				// A collapsed overflow box (data-kind === 'overflow', no data-expanded) does not raise contentH.
				if (li.dataset.kind === 'overflow' && li.dataset.expanded !== 'true') continue;
				if (li.dataset.kind === 'overflow') {
					const sentence = li.querySelector<HTMLElement>('.mark-note');
					const liTop = Number.parseFloat(li.style.top);
					const sentenceTop = sentence ? Number.parseFloat(sentence.style.top) : Number.NaN;
					if (!sentence || !Number.isFinite(liTop) || !Number.isFinite(sentenceTop)) continue;
					const top = plateTop + liTop + sentenceTop;
					notes.push({ top, bottom: top + sentence.offsetHeight });
					continue;
				}
				const rel = Number.parseFloat(li.style.top);
				if (!Number.isFinite(rel)) continue;
				const top = plateTop + rel;
				notes.push({ top, bottom: top + li.offsetHeight });
			}
			const plateLeft = Number.parseFloat(plateFrame.style.left);
			const plateWidth = Number.parseFloat(plateFrame.style.width);
			const hugged = hugSettledPlate({
				paneHeight,
				plate: {
					left: Number.isFinite(plateLeft) ? plateLeft : 0,
					top: plateTop,
					width: Number.isFinite(plateWidth) ? plateWidth : 0,
					height: plateHeight,
				},
				notes,
				padPx: pad,
			});
			plateFrame.style.top = `${hugged.plate.top}px`;
			const pose = tallPose.get(figure);
			if (pose) pose.plate = { ...pose.plate, top: hugged.plate.top };
			figure.dataset.settledH = String(hugged.height);
			const px = `${hugged.height}px`;
			if (mode === 'page') {
				page.style.setProperty('--imagery-h', px);
				figure.style.removeProperty('--imagery-h');
			} else {
				figure.style.setProperty('--imagery-h', px);
				page.style.setProperty('--imagery-h', px);
			}
			figure.dataset.paneSettle = '1';
		}

		function matchPlateFrame(frame: HTMLElement): void {
			const plateFrame = frame.querySelector<HTMLElement>('.plate-frame');
			const windowEl = frame.querySelector<HTMLElement>('.crop-window');
			if (!plateFrame || !windowEl) return;
			const left = plateFrame.style.left;
			const top = plateFrame.style.top;
			const width = plateFrame.style.width;
			const height = plateFrame.style.height;
			if (left === '' || top === '' || width === '' || height === '') return;
			windowEl.style.left = left;
			windowEl.style.top = top;
			windowEl.style.width = width;
			windowEl.style.height = height;
		}

		// `paints` is false for every frame that is not the active one: the frame may still fade
		// as a photograph, but its plate, boxes, elbow leaders, and notes stay off.
		function applyFrame(frame: HTMLElement, p: number, paints = true): void {
			const outer = frame.querySelector<HTMLElement>('.upright-outer');
			const upright = outer?.querySelector<HTMLImageElement>('.upright') ?? null;
			const windowEl = frame.querySelector<HTMLElement>('.crop-window');
			const windowImg = windowEl?.querySelector<HTMLImageElement>('.upright') ?? null;
			const plate = frame.querySelector<HTMLImageElement>('.plate');
			const graphics = frame.querySelector<SVGGElement>('.mark-graphics');
			const leaders = frame.querySelector<SVGGElement>('.mark-leaders');
			const notes = frame.querySelector<HTMLOListElement>('.mark-list');
			const notesOn = frame.dataset.notes === 'aligned';
			const visual = stageVisual(p, notesOn);
			const pose = layoutSplit(frame);
			const paint = fillCropPaint({
				cropT: visual.cropT,
				local: p,
				plateEnd: PLATE_END,
			});
			if (upright && pose) {
				const box = zoomImageBox({
					opening: pose.opening,
					plate: pose.plate,
					natural: pose.natural,
					crop: pose.crop,
					cropT: 1,
				});
				const live = zoomImageBox({
					opening: pose.opening,
					plate: pose.plate,
					natural: pose.natural,
					crop: pose.crop,
					cropT: visual.cropT,
				});
				upright.style.objectFit = 'fill';
				upright.style.maxWidth = 'none';
				upright.style.maxHeight = 'none';
				upright.style.transformOrigin = '0 0';
				upright.style.opacity = '1';
				if (outer) {
					outer.style.opacity = String(paint.outerOpacity);
					outer.style.visibility = paint.outerOpacity === 0 ? 'hidden' : 'visible';
				}
				const windowBox = cropWindow({
					image: box,
					naturalWidth: pose.natural.width,
					crop: pose.crop,
				});
				const liveWindow = cropWindow({
					image: live,
					naturalWidth: pose.natural.width,
					crop: pose.crop,
				});
				const zoomKey = `${window.innerWidth}x${window.innerHeight}x${isNarrow() ? 1 : 0}`;
				if (windowEl) {
					windowEl.style.opacity = String(paint.windowOpacity);
					windowEl.style.visibility = 'visible';
					windowEl.style.transformOrigin = '0 0';
					if (windowBox.width <= 0 || windowBox.height <= 0) {
						windowEl.style.left = '';
						windowEl.style.top = '';
						windowEl.style.width = '';
						windowEl.style.height = '';
						windowEl.style.transform = 'none';
						upright.style.transform = 'none';
					} else if (frame.dataset.zoomBase !== zoomKey) {
						upright.style.right = 'auto';
						upright.style.bottom = 'auto';
						upright.style.left = `${box.left}px`;
						upright.style.top = `${box.top}px`;
						upright.style.width = `${box.width}px`;
						upright.style.height = `${box.height}px`;
						windowEl.style.left = `${windowBox.left}px`;
						windowEl.style.top = `${windowBox.top}px`;
						windowEl.style.width = `${windowBox.width}px`;
						windowEl.style.height = `${windowBox.height}px`;
						if (windowImg) {
							windowImg.style.objectFit = 'fill';
							windowImg.style.maxWidth = 'none';
							windowImg.style.maxHeight = 'none';
							windowImg.style.right = 'auto';
							windowImg.style.bottom = 'auto';
							windowImg.style.left = `${box.left - windowBox.left}px`;
							windowImg.style.top = `${box.top - windowBox.top}px`;
							windowImg.style.width = `${box.width}px`;
							windowImg.style.height = `${box.height}px`;
							windowImg.style.opacity = '1';
							windowImg.style.transform = 'none';
						}
						frame.dataset.zoomBase = zoomKey;
					}
					if (windowBox.width > 0 && windowBox.height > 0) {
						if (visual.cropT === 1) {
							upright.style.transform = 'none';
							windowEl.style.transform = 'none';
						} else {
							upright.style.transform = layerTransform(box, live);
							windowEl.style.transform = layerTransform(windowBox, liveWindow);
						}
					}
				}
				if (visual.cropT === 1) matchPlateFrame(frame);
			}
			const showContent = paints;
			frame.classList.toggle('is-plate', showContent && paint.plateOpacity === 1);
			if (plate) plate.style.opacity = String(showContent ? paint.plateOpacity : 0);
			if (graphics) {
				graphics.style.opacity = String(showContent ? visual.boxesOpacity : 0);
				graphics.style.visibility = showContent && visual.boxesOpacity > 0 ? 'visible' : 'hidden';
			}
			if (leaders) {
				const leadersOn = showContent && visual.leadersOpacity > 0;
				leaders.style.opacity = leadersOn ? '1' : '0';
				leaders.style.visibility = leadersOn ? 'visible' : 'hidden';
				if (leadersOn) {
					frame.querySelectorAll<SVGPolylineElement>('.mark-leader-mask').forEach((mask) => {
						mask.setAttribute('pathLength', '1');
						mask.setAttribute('stroke-dasharray', '1');
						mask.setAttribute('stroke-dashoffset', String(1 - visual.leadersOpacity));
					});
				}
			}
			if (notes) {
				notes.style.opacity = String(showContent ? visual.notesOpacity : 0);
				notes.style.visibility = showContent && visual.notesOpacity > 0 ? 'visible' : 'hidden';
			}
		}

		function bindSplit(): void {
			const page = document.querySelector<HTMLElement>('.record-page--split');
			if (!page) return;
			const runway = page.querySelector<HTMLElement>('.camera-runway');
			const read = page.querySelector<HTMLElement>('.split-read');
			const track = page.querySelector<HTMLElement>('.split-read-track');
			const frames = [...page.querySelectorAll<HTMLElement>('.split-frame')];
			if (!runway || frames.length === 0) return;

			for (const frame of frames) {
				frame.querySelector('img.plate')?.addEventListener('load', () => {
					delete frame.dataset.placeKey;
					delete frame.dataset.zoomBase;
					poseKey.delete(frame);
					applyAll();
				});
			}

			const motionOk = () => document.documentElement.dataset.motion === 'ok';
			let ticking = false;
			let pointerDown = false;
			let settling = false;
			let idleTimer = 0;
			let settledPlaced = false;
			let readingLatch: { index: number; key: string } | null = null;
			let runwayMetrics: {
				pageTop: number;
				travel: number;
				readHeight: number;
				trackHeight: number;
			} | null = null;

			const collapseSvh = () => (isNarrow() && motionOk() ? COLLAPSE_SVH : 0);

			const coverIndex = (() => {
				const i = frames.findIndex((frame) => frame.dataset.part === 'cover');
				return i >= 0 ? i : 0;
			})();

			const settleToKeypoint = () => {
				if (!motionOk() || pointerDown || settling) return;
				// The bar owns the scroll: smooth-scrolling at a tall-runway Y here is exactly what
				// flies the viewport past the collapsed runway and lands on the map.
				if (page.dataset.phase === 'reading') return;
				const { rect, travel, pageTop, p } = geometry();
				if (!shouldSettleRunway(rect.top, rect.bottom, window.innerHeight, SETTLE_SLACK_PX)) return;
				if (travel <= 0) return;
				const notes = frames.map((frame) => frame.dataset.notes === 'aligned');
				const collapse = collapseSvh();
				const target = nearestSettlePlace(p, frames.length, notes, collapse);
				// Inside the collapse segment the keypoint is the bar itself: snap in whole, never
				// lerp a tall-runway Y across the threshold.
				const placeNow = placeOnRunway(p, frames.length, collapse);
				// `collapse` is the travel height (55svh on narrow), not a progress: feeding it to
				// collapseVisual clamps to 1 and makes the bar look "on" at every keypoint, which
				// skips the whole hero. Ask the bar about the collapse the reader is actually at.
				if (
					settledBarOn(collapseVisual(placeNow.collapse).thumbT, placeNow.collapse) ||
					settledBarOn(collapseVisual(target.collapse).thumbT, target.collapse) ||
					placeNow.collapse >= SETTLED_COLLAPSE_T
				) {
					enterSettledReading();
					return;
				}
				let top = runwayScrollY(
					pageTop,
					travel,
					frames.length,
					target.index,
					target.local,
					collapse,
					target.collapse,
				);
				// The notes keypoint is the pass/joint boundary. Floor it so the integer scroll stays on the pass.
				if (target.collapse <= 0 && target.local === 1 && target.index < frames.length - 1) {
					top = Math.floor(top);
				}
				const driftedIntoJoint =
					placeNow.joint > 0 && placeNow.outgoing === target.index && target.local === 1;
				if (!driftedIntoJoint && Math.abs(top - window.scrollY) <= SETTLE_EPSILON_PX) return;
				settling = true;
				window.scrollTo({ top, behavior: 'smooth' });
				window.setTimeout(() => {
					settling = false;
				}, SETTLE_LOCK_MS);
			};

			// Integer scroll can round the same boundary up to 1px into the joint. That pixel is still this pass.
			const placeForScroll = (p: number, travelPx: number): RunwayPlace => {
				const collapse = collapseSvh();
				const place = placeOnRunway(p, frames.length, collapse);
				if (place.collapse > 0) return place;
				if (place.joint <= 0 || place.outgoing < 0 || travelPx <= 0) return place;
				const total = runwayTravelSvh(frames.length, collapse);
				if (total <= 0) return place;
				const passEnd = place.outgoing * (PASS_SVH + JOINT_SVH) + PASS_SVH;
				const overshootPx = ((Math.min(1, Math.max(0, p)) * total - passEnd) * travelPx) / total;
				if (overshootPx > 0 && overshootPx <= 1) {
					return { index: place.outgoing, local: 1, joint: 0, outgoing: -1, collapse: 0 };
				}
				return place;
			};

			const localFor = (frameIndex: number, place: RunwayPlace): number => {
				if (place.joint > 0 && frameIndex === place.outgoing) return 1;
				if (frameIndex === place.index) return place.local;
				if (frameIndex < place.index) return 1;
				return 0;
			};

			const clearScrubStyles = () => {
				if (track) track.style.transform = '';
				for (const frame of frames) {
					frame.style.transitionDuration = '0s';
					frame
						.querySelectorAll<HTMLElement>('.upright-outer, .crop-window, .upright, .plate, .mark-graphics, .mark-leaders, .mark-list')
						.forEach((node) => {
							node.style.opacity = '';
							node.style.visibility = '';
							node.style.transform = '';
							node.style.transformOrigin = '';
						});
					delete frame.dataset.zoomBase;
					frame.querySelectorAll<HTMLImageElement>('.upright').forEach((node) => {
						node.style.left = '';
						node.style.top = '';
						node.style.width = '';
						node.style.height = '';
						node.style.right = '';
						node.style.bottom = '';
					});
					frame.querySelectorAll<HTMLElement>('.crop-window').forEach((node) => {
						node.style.left = '';
						node.style.top = '';
						node.style.width = '';
						node.style.height = '';
					});
					frame.querySelectorAll<HTMLElement>('.plate-frame').forEach((node) => {
						node.style.left = '';
						node.style.top = '';
						node.style.width = '';
						node.style.height = '';
						node.style.maxWidth = '';
						node.style.maxHeight = '';
						node.style.transform = '';
					});
					frame.querySelectorAll<HTMLImageElement>('.plate').forEach((node) => {
						node.style.width = '';
						node.style.height = '';
						node.style.maxWidth = '';
						node.style.maxHeight = '';
					});
				}
			};

			const showSettled = () => {
				clearScrubStyles();
				if (read) read.setAttribute('data-pace', 'pin');
				const place = !settledPlaced;
				for (const frame of frames) {
					frame.classList.add('is-active');
					frame.inert = false;
					frame.removeAttribute('aria-hidden');
					frame.style.transitionDuration = '0s';
					applyFrame(frame, 1);
					if (frame.dataset.notes === 'aligned' && place) {
						try {
							position(frame);
							// 先盘后文: do not hug the pane during reveal; reduced-motion jumps to thumb.
						} catch {
							/* the settled plate is already on screen */
						}
					}
					matchPlateFrame(frame);
				}
				// 先盘后文: reduced motion keeps the static stack — no runway, so no black hole to
				// collapse; the settled bar is for the animated narrow path only.
				if (isNarrow() && motionOk() && page.dataset.phase !== 'reading') {
					enterSettledReading();
				}
				if (place) settledPlaced = true;
			};

			const armFade = () => {
				const duration = motionOk() ? `${DETAIL_CROSSFADE_MS}ms` : '0s';
				for (const frame of frames) {
					frame.style.transitionProperty = 'opacity';
					frame.style.transitionDuration = duration;
					frame.style.transitionTimingFunction = 'linear';
				}
			};

			const geometry = () => {
				const rect = runway.getBoundingClientRect();
				const travel = runway.offsetHeight - window.innerHeight;
				const pageTop = rect.top + window.scrollY;
				const p = runwayProgress(window.scrollY, pageTop, travel);
				runwayMetrics = {
					pageTop,
					travel,
					readHeight: runwayMetrics?.readHeight ?? 0,
					trackHeight: runwayMetrics?.trackHeight ?? 0,
				};
				return { rect, travel, pageTop, p };
			};

			const setActive = (index: number) => {
				frames.forEach((frame, frameIndex) => {
					const on = frameIndex === index;
					frame.classList.toggle('is-active', on);
					frame.inert = !frame.classList.contains('is-active');
					if (frame.classList.contains('is-active')) frame.removeAttribute('aria-hidden');
					else frame.setAttribute('aria-hidden', 'true');
				});
			};

			const placeKeyFor = () => `${window.innerWidth}x${window.innerHeight}x${openOverflowId ?? ''}`;

			// —— settled 头栏 [mini cover | tombstone] ——
			// The one tombstone is moved into the bar slot itself: the title is drawn inside the
			// fixed bar (same layer as the mini cover), not hung over it with a negative margin.
			const settledBar = page.querySelector<HTMLElement>('.split-read .record-tombstone');
			const settledSlot = page.querySelector<HTMLElement>('.split-settled-bar');
			const settledHome = settledBar?.parentElement ?? null;
			let settledTopPx = 0;
			// The bar lands on a page whose height just fell by hundreds of px: a smooth still flying
			// at the tall runway, a wheel burst still delivering queued deltas, or a held PageDown
			// coaxes the viewport straight onto the traj map. The guard puts the column's first
			// screen back for as long as that coasting lasts.
			const SETTLED_PIN_GUARD_MS = 2400;
			// One burst may renew the guard, but not for ever: a reader scrolling the body is not
			// inertia and must get the scroll back within a few seconds of the pin.
			const SETTLED_PIN_GUARD_MAX_MS = 6000;
			// A pin this far below the top counts as a jump. A whole `innerHeight` of slack (the old
			// bound) meant the bar stayed on over a screen that had scrolled away from the body.
			const SETTLED_PIN_SLACK_PX = 48;
			let repinGuardUntil = 0;
			let repinGuardCeiling = 0;

			// Arm (or re-arm) the guard window; the ceiling is set once per pin, at the pin.
			const armSettledPin = (): void => {
				const now = performance.now();
				repinGuardCeiling = now + SETTLED_PIN_GUARD_MAX_MS;
				repinGuardUntil = now + SETTLED_PIN_GUARD_MS;
			};

			const repinSettledPin = (): void => {
				if (page.dataset.phase !== 'reading') {
					repinGuardUntil = 0;
					return;
				}
				// A bounded window: after it the reader owns the scroll again.
				const now = performance.now();
				if (now > repinGuardUntil) return;
				// A finger on the glass is the reader, not inertia: hand the scroll straight back.
				if (pointerDown) {
					repinGuardUntil = 0;
					return;
				}
				// Still on the column's first screen: nothing jumped, nothing to put back.
				if (window.scrollY <= settledTopPx + SETTLED_PIN_SLACK_PX) return;
				// Renew first, so the delta that follows this repin is caught by the same guard.
				repinGuardUntil = Math.min(repinGuardCeiling, now + SETTLED_PIN_GUARD_MS);
				window.scrollTo({ top: settledTopPx, behavior: 'auto' });
			};

			// Re-entrant pin: the phase may already be `reading` while the viewport is nowhere near
			// the bar. Never a bare return — an overshooting wheel must still be walked back.
			const ensureSettledPin = (): void => {
				if (page.dataset.phase !== 'reading') return;
				// Past the ceiling the reader owns the scroll: a late re-entry (the collapse path
				// still asking for the bar mid-body) must not yank them back to the top.
				const now = performance.now();
				if (now > repinGuardCeiling) return;
				window.clearTimeout(idleTimer);
				settling = false;
				// Abort in flight before the pin: a smooth aimed at a tall-runway Y dies in place.
				window.scrollTo({ top: window.scrollY, behavior: 'auto' });
				settledTopPx = runway.getBoundingClientRect().top + window.scrollY;
				window.scrollTo({ top: settledTopPx, behavior: 'auto' });
				// A short record clamps the pin; wherever we landed is the bar's home.
				const landed = window.scrollY;
				if (landed > 0 && landed < settledTopPx) settledTopPx = landed;
				// Renew the window only: the ceiling stays where the pin put it.
				repinGuardUntil = Math.min(repinGuardCeiling, now + SETTLED_PIN_GUARD_MS);
				requestAnimationFrame(() => requestAnimationFrame(repinSettledPin));
			};

			// Column one of the bar is a slot of a known width. A wide plate is contained by that
			// width (and gets shorter) instead of running under the title column.
			const settledCoverSlot = () => {
				const cover = frames[coverIndex];
				const plateImg = cover?.querySelector<HTMLImageElement>('.plate');
				const naturalW = Number.parseFloat(cover?.dataset.plateWidth ?? '') || plateImg?.naturalWidth || 1;
				const naturalH = Number.parseFloat(cover?.dataset.plateHeight ?? '') || plateImg?.naturalHeight || 1;
				return settledCoverBoxPx(naturalW, naturalH, window.innerWidth);
			};

			// One mini cover box, centered in whatever bar height the token line currently says.
			const placeThumbCover = (barH: number, t: number): void => {
				const cover = frames[coverIndex];
				if (!cover) return;
				const plateFrame = cover.querySelector<HTMLElement>('.plate-frame');
				const plateImg = cover.querySelector<HTMLImageElement>('.plate');
				if (!plateFrame || !plateImg) return;
				const u = Math.min(1, Math.max(0, t));
				const pad = 0.75 * remPx();
				const naturalW = Number.parseFloat(cover.dataset.plateWidth ?? '') || plateImg.naturalWidth || 1;
				const naturalH = Number.parseFloat(cover.dataset.plateHeight ?? '') || plateImg.naturalHeight || 1;
				const slotW = Math.round(settledCoverSlot().w);
				const fullH = Math.max(8, barH - 8);
				const thumbH = Math.max(8, THUMB_HEIGHT_PX - 8);
				const aloneH = fullH + (thumbH - fullH) * u;
				const aloneW = (aloneH * naturalW) / naturalH;
				// Land the frame on the slot exactly at u = 1: left = pad-x, box = cover-w.
				const boxW = aloneW + (slotW - aloneW) * u;
				const boxH = (boxW * naturalH) / naturalW;
				const centeredLeft = (window.innerWidth - boxW) / 2;
				plateFrame.style.left = `${centeredLeft + (pad - centeredLeft) * u}px`;
				plateFrame.style.top = `${(barH - boxH) / 2}px`;
				plateFrame.style.width = `${boxW}px`;
				plateFrame.style.height = `${boxH}px`;
				plateFrame.style.maxWidth = 'none';
				plateFrame.style.maxHeight = 'none';
				plateFrame.style.transform = 'none';
				plateImg.style.width = '100%';
				plateImg.style.height = '100%';
				plateImg.style.maxWidth = 'none';
				plateImg.style.maxHeight = 'none';
				matchPlateFrame(cover);
			};

			// CSS owns the default bar height; a clamped-but-still-wrapped title may ask for more.
			// The cover slot is written first: it decides the text column width, so the title has
			// already re-wrapped by the time its height is measured.
			const applySettledHeight = (): number => {
				const slot = settledCoverSlot();
				const coverW = `${Math.round(slot.w)}px`;
				if (page.style.getPropertyValue('--disc-settled-cover-w') !== coverW) {
					page.style.setProperty('--disc-settled-cover-w', coverW);
				}
				if (page.dataset.phase !== 'reading') return DISC_SETTLED_H_PX;
				const next = settledBarHeightPx(settledBar?.scrollHeight ?? 0, slot.h, 0.5 * remPx());
				const now = Number.parseFloat(page.style.getPropertyValue('--disc-settled-h')) || 0;
				if (next !== now) page.style.setProperty('--disc-settled-h', `${next}px`);
				return next;
			};

			// Bar height and cover box come from the same number, always.
			const syncSettledBar = (): number => {
				const barH = applySettledHeight();
				placeThumbCover(barH, 1);
				return barH;
			};

			// Discrete mode: bar on top, runway flow height gone, column right under it.
			const enterSettledReading = (): void => {
				// Already in the bar: still re-pin instead of dropping the request. The wheel that
				// crossed the threshold is usually `reading` for a moment before it has landed.
				if (page.dataset.phase === 'reading') {
					ensureSettledPin();
					return;
				}
				// Cancel first, collapse second: an idle settle already aimed at a tall-runway Y must
				// not survive the flow height going to 0, or it clamps to the document end.
				window.clearTimeout(idleTimer);
				settling = false;
				window.scrollTo({ top: window.scrollY, behavior: 'auto' });
				settledTopPx = runway.getBoundingClientRect().top + window.scrollY;
				page.dataset.phase = 'reading';
				if (settledBar && settledSlot && settledBar.parentElement !== settledSlot) {
					settledSlot.append(settledBar);
				}
				page.style.setProperty('--imagery-h', `${THUMB_HEIGHT_PX}px`);
				page.style.setProperty('--thumb-h', `${THUMB_HEIGHT_PX}px`);
				const cover = frames[coverIndex];
				if (cover) {
					setActive(coverIndex);
					cover.classList.add('is-thumb');
					applyFrame(cover, 1, true);
					for (const layer of cover.querySelectorAll<HTMLElement>(
						'.mark-list, .mark-graphics, .mark-leaders',
					)) {
						layer.style.opacity = '0';
						layer.style.visibility = 'hidden';
					}
				}
				syncSettledBar();
				// Measure the pin against the bar height that is on screen now, not the token guess.
				settledTopPx = runway.getBoundingClientRect().top + window.scrollY;
				page.querySelector('.split-imagery')?.classList.add('is-thumb-hit');
				// The runway just lost its flow height: pin the scroll so the column sits under the bar.
				window.scrollTo({ top: settledTopPx, behavior: 'auto' });
				// A short record clamps the pin; wherever we landed is the bar's home, not a jump out.
				const landed = window.scrollY;
				if (landed > 0 && landed < settledTopPx) settledTopPx = landed;
				armSettledPin();
				requestAnimationFrame(() => requestAnimationFrame(repinSettledPin));
			};

			const exitSettledReading = (): void => {
				if (page.dataset.phase !== 'reading') return;
				delete page.dataset.phase;
				// Out of the bar: the reader owns the scroll, nothing left to walk back.
				repinGuardUntil = 0;
				if (settledBar && settledHome && settledBar.parentElement !== settledHome) {
					settledHome.prepend(settledBar);
				}
				page.style.removeProperty('--disc-settled-h');
				page.style.removeProperty('--disc-settled-cover-w');
				page.querySelector('.split-imagery')?.classList.remove('is-thumb-hit');
				readingLatch = null;
				for (const frame of frames) {
					frame.classList.remove('is-thumb');
					frame.style.opacity = '';
					// The bar pane was 88px tall: drop the pose measured there.
					delete frame.dataset.placeKey;
					delete frame.dataset.zoomBase;
					poseKey.delete(frame);
				}
				page.style.setProperty('--imagery-h', '100svh');
			};

			const resyncSettledBar = (): void => {
				if (page.dataset.phase !== 'reading') {
					// Not in the bar yet: keep the slot token in step for the next entry.
					applySettledHeight();
					return;
				}
				if (!isNarrow()) {
					exitSettledReading();
					return;
				}
				syncSettledBar();
				// New bar height, new padding-top: measure the pin against what is on screen now.
				settledTopPx = runway.getBoundingClientRect().top + window.scrollY;
			};

			const seamDebug = new URLSearchParams(window.location.search).get('debug') === 'seam';
			let seamPrev: {
				imageryH: number;
				readTop: number;
				plateTop: number;
				winTop: number;
				frameH: number;
			} | null = null;

			const logSeam = (frame: HTMLElement | undefined, local: number, cropT: number) => {
				if (!seamDebug || !frame) return;
				const plate = frame.querySelector<HTMLElement>('.plate-frame')?.getBoundingClientRect();
				const win = frame.querySelector<HTMLElement>('.crop-window')?.getBoundingClientRect();
				const imagery = page.querySelector<HTMLElement>('.split-imagery');
				const readEl = page.querySelector<HTMLElement>('.split-read');
				const runwayEl = page.querySelector<HTMLElement>('.camera-runway');
				const imageryH = imagery?.clientHeight ?? 0;
				const readTop = readEl?.getBoundingClientRect().top ?? 0;
				const plateTop = plate?.top ?? 0;
				const winTop = win?.top ?? 0;
				const frameH = frame.clientHeight;
				const prev = seamPrev;
				seamPrev = { imageryH, readTop, plateTop, winTop, frameH };
				if (!prev) return;
				const dImg = imageryH - prev.imageryH;
				const dRead = readTop - prev.readTop;
				const dPlate = plateTop - prev.plateTop;
				const dWin = winTop - prev.winTop;
				const dFrame = frameH - prev.frameH;
				const mismatch = Math.abs(winTop - plateTop);
				if (
					Math.abs(dImg) < 1 &&
					Math.abs(dRead) < 1 &&
					Math.abs(dPlate) < 1 &&
					Math.abs(dWin) < 1 &&
					Math.abs(dFrame) < 1 &&
					mismatch < 1
				) {
					return;
				}
				console.info('[seam]', {
					local,
					cropT,
					scrollY: window.scrollY,
					runwayTop: runwayEl?.getBoundingClientRect().top ?? null,
					imageryH,
					imageryVar: getComputedStyle(page).getPropertyValue('--imagery-h').trim(),
					frameH,
					pageH: page.clientHeight,
					readTop,
					plate: plate
						? { top: plate.top, left: plate.left, width: plate.width, height: plate.height }
						: null,
					window: win ? { top: win.top, left: win.left, width: win.width, height: win.height } : null,
					transform: frame.querySelector<HTMLElement>('.crop-window')?.style.transform ?? '',
					dImg,
					dRead,
					dPlate,
					dWin,
					dFrame,
					mismatch,
				});
			};

			const reserveNarrowPanes = () => {
				// 先盘后文: reveal stays near 100svh; collapse segment owns the shrink to thumb.
				if (!isNarrow()) return;
				if (page.dataset.phase === 'reading') return;
				page.style.setProperty('--imagery-h', '100svh');
			};

			const releaseCollapsedPane = () => {
				page.style.removeProperty('--imagery-h');
				for (const frame of frames) {
					frame.style.removeProperty('--imagery-h');
					if (frame.dataset.paneSettle !== '1') continue;
					delete frame.dataset.paneSettle;
					delete frame.dataset.settledH;
					delete frame.dataset.zoomBase;
					poseKey.delete(frame);
				}
			};

			const rememberReadingBox = () => {
				if (!runwayMetrics || !read || !track) return;
				runwayMetrics.readHeight = read.clientHeight;
				runwayMetrics.trackHeight = track.scrollHeight;
			};

			// Phone dwell: camera and callouts are already parked. Move the column from cached metrics.
			const paceParkedReading = (): boolean => {
				if (!isNarrow() || !runwayMetrics) return false;
				const p = runwayProgress(window.scrollY, runwayMetrics.pageTop, runwayMetrics.travel);
				const place = placeForScroll(p, runwayMetrics.travel);
				const active = frames[place.index];
				if (!active) return false;
				const local = localFor(place.index, place);
				const viewportKey = placeKeyFor();
				if (
					!readingScrollOnly({
						narrow: true,
						local,
						joint: place.joint,
						notesOpacity: stageVisual(local, active.dataset.notes === 'aligned').notesOpacity,
						placeKey: active.dataset.placeKey ?? null,
						viewportKey,
						paneSettled: active.dataset.paneSettle === '1',
						frameIndex: place.index,
						latchedIndex: readingLatch?.index ?? null,
						latchedKey: readingLatch?.key ?? null,
						hasMetrics: true,
					})
				) {
					return false;
				}
				// Narrow 先盘后文: reading is document flow after the runway — do not pace it here.
				if (!isNarrow() && read && track) {
					const offset = readTrackOffset(p, runwayMetrics.trackHeight, runwayMetrics.readHeight);
					read.setAttribute('data-pace', offset === 0 ? 'pin' : 'pace');
					track.style.transform = offset === 0 ? '' : `translateY(${-offset}px)`;
				}
				return true;
			};

			const applyCollapse = (place: RunwayPlace) => {
				const cv = collapseVisual(place.collapse);
				const fullH = window.innerHeight;
				const h = thumbHeightPx(cv.thumbT, fullH, THUMB_HEIGHT_PX);
				page.style.setProperty('--imagery-h', `${h}px`);
				page.style.setProperty('--thumb-h', `${THUMB_HEIGHT_PX}px`);
				const lastIndex = frames.length - 1;
				const cover = frames[coverIndex];
				frames.forEach((frame, frameIndex) => {
					frame.classList.remove('is-thumb');
					const local = 1;
					const isCover = frameIndex === coverIndex;
					const isLast = frameIndex === lastIndex;
					let opacity = 0;
					if (coverIndex === lastIndex) {
						opacity = isCover ? 1 : 0;
					} else if (isLast) {
						opacity = 1 - cv.coverMix;
					} else if (isCover) {
						opacity = cv.coverMix;
					}
					frame.classList.toggle('is-active', opacity > 0.05);
					frame.inert = opacity <= 0.05;
					frame.style.opacity = String(opacity);
					if (opacity > 0.05) frame.removeAttribute('aria-hidden');
					else frame.setAttribute('aria-hidden', 'true');
					if (opacity > 0.05) {
						applyFrame(frame, local, true);
						const notes = frame.querySelector<HTMLOListElement>('.mark-list');
						const graphics = frame.querySelector<SVGGElement>('.mark-graphics');
						const leaders = frame.querySelector<SVGGElement>('.mark-leaders');
						const fade = cv.calloutsOpacity;
						if (notes) {
							notes.style.opacity = String(fade);
							notes.style.visibility = fade > 0 ? 'visible' : 'hidden';
						}
						if (graphics) {
							graphics.style.opacity = String(fade);
							graphics.style.visibility = fade > 0 ? 'visible' : 'hidden';
						}
						if (leaders) {
							leaders.style.opacity = String(fade);
							leaders.style.visibility = fade > 0 ? 'visible' : 'hidden';
						}
					}
				});
				// In the bar the cover sits centered in the measured bar height, never in the shrink
				// height: placing with `h` (≈64) would pin it to the top and leave a black band below.
				if (page.dataset.phase === 'reading') syncSettledBar();
				else if (cv.thumbT > 0) placeThumbCover(h, cv.thumbT);
				// 阈值阈: the bar snaps in whole — never a chip floating over half a screen of --bg.
				if (settledBarOn(cv.thumbT, place.collapse)) enterSettledReading();
				else if (page.dataset.phase === 'reading') exitSettledReading();
			};

			const applyAll = () => {
				if (!motionOk()) {
					readingLatch = null;
					showSettled();
					return;
				}
				// 先盘后文: leaving the settled bar restores the runway before anything measures it.
				if (
					isNarrow() &&
					page.dataset.phase === 'reading' &&
					window.scrollY < settledTopPx - SETTLED_EXIT_PX
				) {
					exitSettledReading();
				}
				if (paceParkedReading()) return;
				const { p, travel } = geometry();
				const place = placeForScroll(p, travel);
				const activeNow = frames[place.index];
				const activeLocalNow = localFor(place.index, place);
				if (
					!activeNow ||
					stageVisual(activeLocalNow, activeNow.dataset.notes === 'aligned').notesOpacity === 0
				) {
					openOverflowId = null;
				}
				if (isNarrow() && motionOk()) {
					reserveNarrowPanes();
				} else if (frames.some((frame) => frame.dataset.paneSettle === '1')) {
					releaseCollapsedPane();
				}
				if (isNarrow() && place.collapse > 0) {
					applyCollapse(place);
					readingLatch = null;
					return;
				}
				if (isNarrow() && page.dataset.phase === 'reading') {
					delete page.dataset.phase;
					page.querySelector('.split-imagery')?.classList.remove('is-thumb-hit');
					frames.forEach((frame) => {
						frame.classList.remove('is-thumb');
						frame.style.opacity = '';
					});
					page.style.setProperty('--imagery-h', '100svh');
				}
				setActive(place.index);
				if (!isNarrow() && read && track) {
					const offset = readTrackOffset(p, track.scrollHeight, read.clientHeight);
					read.setAttribute('data-pace', offset === 0 ? 'pin' : 'pace');
					track.style.transform = offset === 0 ? '' : `translateY(${-offset}px)`;
				} else if (read && track) {
					read.setAttribute('data-pace', 'pin');
					track.style.transform = '';
				}
				frames.forEach((frame, frameIndex) => {
					frame.style.opacity = '';
					const local = localFor(frameIndex, place);
					const visual = stageVisual(local, frame.dataset.notes === 'aligned');
					if (frame.dataset.notes === 'aligned' && calloutsActive(visual)) {
						const key = placeKeyFor();
						if (frame.dataset.placeKey !== key) {
							try {
								position(frame);
								frame.dataset.placeKey = key;
								delete frame.dataset.zoomBase;
							} catch {
								/* keep the last leader placement */
							}
						}
					}
					applyFrame(frame, local, framePaintsContent(frameIndex, place));
				});
				const active = frames[place.index];
				const activeLocal = localFor(place.index, place);
				// 先盘后文: no mid-reveal collapseToContent hug.
				logSeam(
					active,
					activeLocal,
					active ? stageVisual(activeLocal, active.dataset.notes === 'aligned').cropT : 0,
				);
				const latched = frames[place.index];
				const latchedLocal = localFor(place.index, place);
				const viewportKey = placeKeyFor();
				if (
					latched &&
					canLatchReading({
						narrow: isNarrow(),
						local: latchedLocal,
						joint: place.joint,
						notesOpacity: stageVisual(latchedLocal, latched.dataset.notes === 'aligned').notesOpacity,
						placeKey: latched.dataset.placeKey ?? null,
						viewportKey,
						// Pane hug retired on narrow; latch once dwell parks with notes placed or absent.
						paneSettled: !isNarrow() ? latched.dataset.paneSettle === '1' : true,
					})
				) {
					rememberReadingBox();
					readingLatch = { index: place.index, key: viewportKey };
				} else {
					readingLatch = null;
				}
			};

			const onScroll = () => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(() => {
						ticking = false;
						applyAll();
						// Inertia outlives the pin: keep the column's first screen while the guard runs.
						repinSettledPin();
					});
				}
				if (settling || pointerDown || !motionOk()) return;
				window.clearTimeout(idleTimer);
				idleTimer = window.setTimeout(settleToKeypoint, SETTLE_IDLE_MS);
			};

			const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
			motionQuery.addEventListener('change', () => {
				document.documentElement.dataset.motion = motionQuery.matches ? 'reduce' : 'ok';
				if (motionQuery.matches) {
					window.clearTimeout(idleTimer);
					settling = false;
					clearScrubStyles();
					// Reduced motion has no runway to collapse: drop the bar with the travel.
					exitSettledReading();
				} else armFade();
				settledPlaced = false;
				applyAll();
			});

			window.addEventListener('scroll', onScroll, { passive: true });
			// `scrollend` is not in every lib.dom: listen as a plain EventTarget string.
			if ('onscrollend' in window) {
				(window as EventTarget).addEventListener('scrollend', repinSettledPin, { passive: true });
			}
			if (read && track && typeof ResizeObserver !== 'undefined') {
				const readingBox = new ResizeObserver(() => {
					if (!runwayMetrics || !read || !track) return;
					runwayMetrics.readHeight = read.clientHeight;
					runwayMetrics.trackHeight = track.scrollHeight;
				});
				readingBox.observe(read);
				readingBox.observe(track);
			}
			if (settledBar && typeof ResizeObserver !== 'undefined') {
				// A wrapped title (or a later webfont) may need a taller bar than the token, and the
				// bar itself changes when the slot does: rAF-merge, then re-measure both together.
				let barFrame = 0;
				const barBox = new ResizeObserver(() => {
					if (barFrame) return;
					barFrame = requestAnimationFrame(() => {
						barFrame = 0;
						if (page.dataset.phase !== 'reading') return;
						syncSettledBar();
					});
				});
				barBox.observe(settledBar);
				if (settledSlot) barBox.observe(settledSlot);
			}
			window.addEventListener('pointerdown', () => {
				pointerDown = true;
				window.clearTimeout(idleTimer);
			});
			window.addEventListener('pointerup', () => {
				pointerDown = false;
				if (!motionOk()) return;
				window.clearTimeout(idleTimer);
				idleTimer = window.setTimeout(settleToKeypoint, SETTLE_IDLE_MS);
			});
			window.addEventListener('pointercancel', () => {
				pointerDown = false;
			});
			window.addEventListener('resize', () => {
				openOverflowId = null;
				settledPlaced = false;
				readingLatch = null;
				for (const frame of frames) {
					delete frame.dataset.placeKey;
					delete frame.dataset.zoomBase;
					poseKey.delete(frame);
				}
				resyncSettledBar();
				applyAll();
			});
			document.fonts?.ready
				.then(() => {
					settledPlaced = false;
					readingLatch = null;
					for (const frame of frames) delete frame.dataset.placeKey;
					resyncSettledBar();
					applyAll();
				})
				.catch(() => {
					/* fonts.ready rejected; the first placement stands */
				});
			page.querySelector('.split-imagery')?.addEventListener('click', () => {
				if (!isNarrow() || page.dataset.phase !== 'reading') return;
				// 点小图回「唱片」章（题铭＋封面那条长滚的顶上），不退成无底栏幽灵序幕。
				if (chapterReader?.isActive()) {
					chapterReader.goToChapter('record');
					return;
				}
				exitSettledReading();
				const { pageTop, travel } = geometry();
				const top = runwayScrollY(pageTop, travel, frames.length, 0, 0, collapseSvh(), 0);
				applyAll();
				window.scrollTo({ top, behavior: motionOk() ? 'smooth' : 'auto' });
			});

			page.querySelector('.split-imagery')?.addEventListener('pointerdown', (event) => {
				if (openOverflowId === null) return;
				const target = event.target;
				if (!(target instanceof Element)) return;
				if (target.closest('.mark-hit')) return;
				const li = target.closest<HTMLLIElement>('.mark-list li');
				if (li && li.dataset.kind !== 'overflow') return;
				if (li?.dataset.expanded === 'true' && target.closest('.mark-note')) return;
				openOverflowId = null;
				refreshSplit();
			});
			document.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || openOverflowId === null) return;
				openOverflowId = null;
				refreshSplit();
			});
			armFade();
			applyAll();
		}

		function bind(figure: HTMLElement): void {
			position(figure);
			if (figure.dataset.mode !== 'reveal') return;
			settle(figure);
		}

		/**
		 * 窄屏章节壳 v3：收妥即落「唱片」（题铭＋封面＋物述，一条长滚）；
		 * 宽屏化 → 收起，桌面长页一根手指都不碰。
		 */
		function mountChapters(): void {
			const shell = document.querySelector<HTMLElement>('[data-disc-chapters]');
			const page = document.querySelector<HTMLElement>('.record-page');
			const stage = shell?.querySelector<HTMLElement>('[data-chapters-stage]');
			const rail = shell?.querySelector<HTMLElement>('.disc-chapter-rail');
			if (!shell || !page || !stage || !rail) return;
			const reader = mountChapterReader({ shell, page, stage, rail, isNarrow });
			const sync = (): void => {
				const reading = isNarrow() && page.dataset.phase === 'reading';
				reader.setActive(reading);
			};
			new MutationObserver(sync).observe(page, { attributes: true, attributeFilter: ['data-phase'] });
			window.addEventListener('resize', sync);
			chapterReader = reader;
			sync();
		}

		function init(): void {
			const figures = [...document.querySelectorAll<HTMLElement>('.detail-figure')];
			for (const figure of figures) {
				try {
					bind(figure);
				} catch {
					settle(figure);
				}
				figure.querySelector('img.plate')?.addEventListener('load', () => {
					try {
						position(figure);
					} catch {
						/* keep the last placement */
					}
				});
			}
			const reposition = () => {
				for (const figure of figures) {
					try {
						position(figure);
					} catch {
						/* keep the last placement */
					}
				}
			};
			window.addEventListener('resize', reposition);
			document.fonts?.ready.then(reposition).catch(() => {
				/* fonts.ready rejected; the first placement stands */
			});
			try {
				const media = window.matchMedia('(prefers-reduced-motion: reduce)');
				media.addEventListener('change', () => {
					document.documentElement.dataset.motion = media.matches ? 'reduce' : 'ok';
					if (media.matches) {
						for (const figure of figures) {
							if (figure.dataset.mode === 'reveal') settle(figure);
						}
					}
				});
			} catch {
				/* head script already set data-motion, or left it unset */
			}
			bindSplit();
			mountChapters();
		}

		init();
	</script>
</Base>
