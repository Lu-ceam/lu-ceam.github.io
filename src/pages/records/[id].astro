					</div>
					<nav class="disc-chapter-rail" aria-label="章节（点选翻章）">
						{chapters.map((chapter, chapterIndex) => (
							<button
								type="button"
								class="disc-chapter-dot"
								data-chapter-goto={chapterIndex}
								aria-current={chapterIndex === 0 ? 'true' : 'false'}
