---
import Base from '../../layouts/Base.astro';
import {
	badgeCenter,
	detailMode,
	notesAligned,
	paintSide,
	showDetailsNote,
	showMarkLabel,
	visibleDetailText,
} from '../../data/detail-display';
import { noteIndexPrefix } from '../../data/callout-notes';
import {
	buildDiscChapters,
	CHAPTER_LABELS,
	coverSides as buildCoverSides,
	discNotesFields,
	parseStorySections,
} from '../../data/disc-chapters';
import {
	badgeClass,
	detailDomKey,
	formatDetailFace,
	heroAlt,
	records,
	resolveDetailFace,
	splitLeadSentence,
	storyParagraphs,
	showMatrix,
	showPressing,
	type VinylRecord,
} from '../../data/records';
import TrajectoryMap from '../../components/TrajectoryMap.astro';

export function getStaticPaths() {
	return records.map((record) => ({
		params: { id: record.id },
		props: { record },
	}));
}

const { record } = Astro.props as { record: VinylRecord };
const title = `${record.work} · ${record.catalogNumber}`;
const when = record.year ?? record.decade;
// Empty marks still reveal when the crop is a real sub-rectangle. The
// entry-hero / data-mode="legacy" branch is only the unpublished fallback.
const revealDetails = record.details.filter((d) => detailMode(d) === 'reveal');
const nonRevealDetails = record.details.filter((d) => detailMode(d) !== 'reveal');
const hasReveal = revealDetails.length > 0;

/**
 * 著录字段：桌面 `<dl class="props">` 与窄屏「资料」章共用这一份，
 * 一处定义、两处渲染，省得字段名走散。
 */
const propsFields = discNotesFields(record, {
	showMatrix: showMatrix(record),
	showPressing: showPressing(record),
});

/**
 * 窄屏章节 v3：唱片（题铭＋封面＋物述）／述语（公开长文一篇）／地图／资料（著录字段）。
 * 没分章就整段落进「唱片」；空章不出现在底栏，也不用假文案占位。
 */
const chapters = buildDiscChapters({
	story: record.story,
	hasMap: Boolean(record.trajectory),
	notesFields: propsFields,
	extraRecordParagraphs: revealDetails
		.map((detail) => visibleDetailText(detail))
		.filter((text): text is string => Boolean(text)),
});
const hasStoryChapters = /^##[ \t]+\S/m.test(record.story);

/** 唱片章的封面相：题铭与封面同屏，缩放由阅读器接管。 */
const coverDetail = revealDetails[0];
/**
 * 正背／多面都进唱片章：切面按导出／版面同序，第一面默认；
 * 只有一面就不摆切面控件（不拿空控件占位置）。
 */
const coverSides = buildCoverSides(
	revealDetails.map((detail) => ({
		part: detail.part,
		caption: detail.caption,
		face: formatDetailFace(resolveDetailFace(detail)),
	})),
);
const coverDetails = revealDetails;

/**
 * 桌面连续读仍走同一条长页：有 `##` 章时按原文自己的章标题立标题
 * （桌面不改写作侧的标题，只有窄屏底栏文案是「述语」），
 * 只让全篇第一段保留 lead 强调（与 `storyParagraphs` 同一套排版）。
 */
let leadTaken = false;
const chapterBlocks = parseStorySections(record.story).map((section) => ({
	title:
		section.title !== ''
			? section.title
			: CHAPTER_LABELS[section.key ?? 'record'],
	blocks: section.blocks.map((block) => ({
		title: block.title,
		paragraphs: block.paragraphs.map((text) => {
			if (leadTaken) return { lead: null as string | null, body: text };
			leadTaken = true;
			const { lead, rest } = splitLeadSentence(text);
			return { lead, body: rest };
		}),
	})),
}));

/** No-JS and first paint. Horizontal stand-in. The elbow is written later by position(). */
function standInLeaderPoints(
	mark: { side: 'auto' | 'left' | 'right'; x: number; y: number; w: number; h: number },
	plateWidth: number,
): string {
	const side = paintSide(mark.side);
	const x1 = side === 'left' ? mark.x : mark.x + mark.w;
	const y1 = mark.y + mark.h / 2;
	const x2 = side === 'left' ? 0 : plateWidth;
	return `${x1},${y1} ${x2},${y1}`;
}

function leaderMaskId(recordId: string, domKey: string, markId: string): string {
	return `${recordId}-${domKey}-leader-mask-${markId}`;
}
---

<Base title={title} description={record.notes} wide>
	<article
		class:list={['record-page', hasReveal && 'record-page--split']}
		data-record-id={record.id}
	>
		<p class="record-back">
			<a href="/records/">← 目录</a>
		</p>
		{!hasReveal && (
		<div class="record-split">
			<div class="record-object">
				<figure class="entry-hero">
					<img
						src={record.image.src}
						width={record.image.width}
						height={record.image.height}
						alt={heroAlt(record)}
						decoding="async"
						fetchpriority="high"
					/>
					<figcaption>{record.photo}</figcaption>
				</figure>
				{
					showDetailsNote(record) && <p class="meta">{record.detailsNote}</p>
				}
				<div class="detail-grid">
					{
						record.details.map((detail) => {
							const mode = detailMode(detail);
							const aligned = notesAligned(detail);
							const remainder = visibleDetailText(detail);
							const sides = new Set(detail.marks.map((mark) => paintSide(mark.side)));
							const faceLabel = formatDetailFace(resolveDetailFace(detail));
							return (
								<figure
									class:list={[
										'detail-figure',
										mode === 'reveal' && 'is-reveal',
										mode !== 'legacy' && 'has-stage',
									]}
									data-part={detail.part}
									data-disc={detail.disc}
									data-side={detail.side}
									data-mode={mode}
									data-plate-width={detail.plate.width}
									data-plate-height={detail.plate.height}
									data-notes={aligned ? 'aligned' : 'open'}
								>
									{mode === 'legacy' ? (
										<img
											src={detail.plate.src}
											width={detail.plate.width}
											height={detail.plate.height}
											alt={detail.alt}
											decoding="async"
											loading="lazy"
										/>
									) : (
										<div class="detail-stage">
											{aligned && sides.has('left') && <div class="mark-slot mark-slot-left" />}
											<div class="plate-frame">
												<img
													class="plate"
													src={detail.plate.src}
													width={detail.plate.width}
													height={detail.plate.height}
													alt={detail.alt}
													decoding="async"
													loading="lazy"
												/>
												{mode === 'reveal' && detail.upright && detail.transform && (
													<div class="upright-clip">
														<img
															class="upright"
															src={detail.upright.src}
															width={detail.upright.width}
															height={detail.upright.height}
															alt=""
															aria-hidden="true"
															decoding="async"
															loading="lazy"
															data-crop-x={detail.transform.crop.x}
															data-crop-y={detail.transform.crop.y}
															data-crop-w={detail.transform.crop.w}
															data-crop-h={detail.transform.crop.h}
														/>
													</div>
												)}
												{detail.marks.length > 0 && (
													<svg
														class="plate-overlay"
														viewBox={`0 0 ${detail.plate.width} ${detail.plate.height}`}
														overflow="visible"
														aria-hidden="true"
													>
														{aligned && (
															<defs>
																{detail.marks.map((mark) => (
																	<mask
																		id={leaderMaskId(record.id, detailDomKey(detail), mark.id)}
																		maskUnits="userSpaceOnUse"
																		maskContentUnits="userSpaceOnUse"
																		x={-4}
																		y={-4}
																		width={detail.plate.width + 8}
																		height={detail.plate.height + 8}
																		data-mark-id={mark.id}
																	>
																		<polyline
																			class="mark-leader-mask"
																			data-mark-id={mark.id}
																			points={standInLeaderPoints(mark, detail.plate.width)}
																			fill="none"
																			stroke="#fff"
																			stroke-width="3"
																			stroke-linecap="butt"
																		/>
																	</mask>
																))}
															</defs>
														)}
														<g class="mark-graphics">
															{detail.marks.map((mark, index) => {
																const badge = badgeCenter(mark, detail.plate.width);
																return (
																	<g class="mark-callout" data-mark-id={mark.id}>
																		<rect
																			class="mark-box-halo"
																			x={mark.x}
																			y={mark.y}
																			width={mark.w}
																			height={mark.h}
																			stroke-width="4"
																		/>
																		<rect
																			class="mark-box"
																			x={mark.x}
																			y={mark.y}
																			width={mark.w}
																			height={mark.h}
																			stroke-width="2"
																		/>
																		<circle
																			class="mark-disc"
																			cx={badge.cx}
																			cy={badge.cy}
																			r={badge.r}
																			stroke-width="2"
																		/>
																		<text
																			class="mark-num"
																			x={badge.cx}
																			y={badge.cy}
																			font-size={badge.fontSize}
																		>
																			{index + 1}
																		</text>
																	</g>
																);
															})}
														</g>
														{aligned && (
															<g class="mark-leaders">
																{detail.marks.map((mark) => (
																	<polyline
																		class="mark-leader"
																		data-mark-id={mark.id}
																		points={standInLeaderPoints(mark, detail.plate.width)}
																		mask={`url(#${leaderMaskId(record.id, detailDomKey(detail), mark.id)})`}
																		fill="none"
																		stroke-width="1"
																	/>
																))}
															</g>
														)}
													</svg>
												)}
												{aligned && (
													<ol class="mark-list" aria-label="题铭">
														{detail.marks.map((mark, index) => (
															<li
																id={`${record.id}-${detailDomKey(detail)}-mark-${mark.id}`}
																data-mark-id={mark.id}
																data-index={index}
																data-side={paintSide(mark.side)}
																data-side-pref={mark.side}
																data-badge={mark.badge}
																data-x={mark.x}
																data-y={mark.y}
																data-w={mark.w}
																data-h={mark.h}
															>
																<span class="mark-index">{index + 1}</span>
																{showMarkLabel(mark) && <p class="mark-label">{mark.label}</p>}
																<p class="mark-note">{mark.note}</p>
															</li>
														))}
													</ol>
												)}
											</div>
											{aligned && sides.has('right') && <div class="mark-slot mark-slot-right" />}
										</div>
									)}
									<figcaption>
										{faceLabel && <span class="detail-face">{faceLabel}</span>}
										{faceLabel && <span class="detail-face-sep" aria-hidden="true"> · </span>}
										{detail.caption}
									</figcaption>
									{remainder && <p class="detail-text">{remainder}</p>}
								</figure>
							);
						})
					}
				</div>
			</div>
			<div class="record-text">
				<header class="record-tombstone">
					<h1>{record.work}</h1>
					<p class="record-tombstone-meta">
						<span>{record.artist}</span>
						<span aria-hidden="true"> · </span>
						<span>{record.label}</span>
						<span aria-hidden="true"> · </span>
						<span>{record.catalogNumber}</span>
						<span aria-hidden="true"> · </span>
						<span>{when}</span>
						<span class={badgeClass(record.status)}>{record.status}</span>
					</p>
				</header>
				<div class="record-story" lang="zh-Hans">
					{hasStoryChapters ? (
						chapterBlocks.map((chapter) => (
							<section class="record-story-section">
								<h2 class="record-story-chapter">{chapter.title}</h2>
								{chapter.blocks.map((section) => (
									<>
										{section.title !== '' && (
											<h3 class="record-story-beat">{section.title}</h3>
										)}
										{section.paragraphs.map((paragraph) => (
											<p>
												{paragraph.lead !== null && (
													<strong class="record-story-lead">{paragraph.lead}</strong>
												)}{paragraph.body}
											</p>
										))}
									</>
								))}
							</section>
						))
					) : (
						storyParagraphs(record.story).map((paragraph) => (
							<p>
								{paragraph.lead !== null && (
									<strong class="record-story-lead">{paragraph.lead}</strong>
								)}{paragraph.body}
							</p>
						))
					)}
				</div>
				<dl class="props" aria-label="著录">
					<dt>艺人</dt>
					<dd>{record.artist}</dd>
					<dt>作曲家</dt>
					<dd>{record.composer}</dd>
					<dt>作品</dt>
					<dd>{record.work}</dd>
					<dt>厂牌</dt>
					<dd>{record.label}</dd>
					<dt>目录号</dt>
					<dd>{record.catalogNumber}</dd>
					{
						showMatrix(record) && record.matrix && (
							<>
								<dt>内圈刻字</dt>
								<dd>{record.matrix}</dd>
							</>
						)
					}
					{
						showPressing(record) && record.pressing && (
							<>
								<dt>压片</dt>
								<dd>{record.pressing}</dd>
							</>
						)
					}
					<dt>录音</dt>
					<dd>{record.recording}</dd>
					<dt>品相</dt>
					<dd>{record.condition}</dd>
					<dt>均衡</dt>
					<dd>{record.eq}</dd>
					<dt>状态</dt>
					<dd>{record.status}</dd>
					{
						record.year !== undefined && (
							<>
								<dt>年份</dt>
								<dd>{record.year}</dd>
							</>
						)
					}
				</dl>
				<details class="fold">
					<summary>出处</summary>
					<ul class="link-cards">
						{
							record.links.map((link) => (
								<li>
									<a href={link.href} target="_blank" rel="noopener noreferrer">
										<span class="link-title">{link.title}</span>
										<span class="link-site">{link.site}</span>
									</a>
								</li>
							))
						}
					</ul>
				</details>
			</div>
		</div>
		)}
		{
			hasReveal && (
				<div class="split-stage">
					<div class="camera-runway" style={`--pass-count: ${revealDetails.length};`}>
					<div class="split-imagery">
						{revealDetails.map((detail, index) => {
							const aligned = notesAligned(detail);
							return (
								<div
									class:list={['split-frame', index === 0 && 'is-active']}
									data-part={detail.part}
									data-disc={detail.disc}
									data-side={detail.side}
									data-plate-width={detail.plate.width}
									data-plate-height={detail.plate.height}
									data-notes={aligned ? 'aligned' : 'open'}
									inert={index !== 0}
									style={`--plate-w: ${detail.plate.width}; --plate-h: ${detail.plate.height};`}
								>
									{detail.upright && detail.transform && (
										<>
											<div class="upright-outer" data-fill-crop="outer">
												<img
													class="upright"
													src={detail.upright.src}
													width={detail.upright.width}
													height={detail.upright.height}
													alt=""
													aria-hidden="true"
													decoding="async"
													loading="eager"
													data-crop-x={detail.transform.crop.x}
													data-crop-y={detail.transform.crop.y}
													data-crop-w={detail.transform.crop.w}
													data-crop-h={detail.transform.crop.h}
												/>
											</div>
											<div class="crop-window" data-fill-crop="window">
												<img
													class="upright"
													src={detail.upright.src}
													width={detail.upright.width}
													height={detail.upright.height}
													alt=""
													aria-hidden="true"
													decoding="async"
													loading="eager"
													data-crop-x={detail.transform.crop.x}
													data-crop-y={detail.transform.crop.y}
													data-crop-w={detail.transform.crop.w}
													data-crop-h={detail.transform.crop.h}
												/>
											</div>
										</>
									)}
									<div class="detail-stage">
										<div class="plate-frame">
											<img
												class="plate"
												src={detail.plate.src}
												width={detail.plate.width}
												height={detail.plate.height}
												alt={detail.alt}
												decoding="async"
												fetchpriority={index === 0 ? 'high' : 'auto'}
												loading="eager"
											/>
											{detail.marks.length > 0 && (
												<svg
													class="plate-overlay"
													viewBox={`0 0 ${detail.plate.width} ${detail.plate.height}`}
													overflow="visible"
													aria-hidden="true"
												>
													{aligned && (
														<defs>
															{detail.marks.map((mark) => (
																<mask
																	id={leaderMaskId(record.id, detailDomKey(detail), mark.id)}
																	maskUnits="userSpaceOnUse"
																	maskContentUnits="userSpaceOnUse"
																	x={-4}
																	y={-4}
																	width={detail.plate.width + 8}
																	height={detail.plate.height + 8}
																	data-mark-id={mark.id}
																>
																	<polyline
																		class="mark-leader-mask"
																		data-mark-id={mark.id}
																		points={standInLeaderPoints(mark, detail.plate.width)}
																		fill="none"
																		stroke="#fff"
																		stroke-width="3"
																		stroke-linecap="butt"
																	/>
																</mask>
															))}
														</defs>
													)}
													<g class="mark-graphics">
														{detail.marks.map((mark) => (
															<g class="mark-callout" data-mark-id={mark.id}>
																<rect
																	class="mark-box-halo"
																	x={mark.x}
																	y={mark.y}
																	width={mark.w}
																	height={mark.h}
																	stroke-width="4"
																/>
																<rect
																	class="mark-box"
																	x={mark.x}
																	y={mark.y}
																	width={mark.w}
																	height={mark.h}
																	stroke-width="2"
																/>
															</g>
														))}
													</g>
													{aligned && (
														<g class="mark-leaders">
															{detail.marks.map((mark) => (
																<polyline
																	class="mark-leader"
																	data-mark-id={mark.id}
																	points={standInLeaderPoints(mark, detail.plate.width)}
																	mask={`url(#${leaderMaskId(record.id, detailDomKey(detail), mark.id)})`}
																	fill="none"
																	stroke-width="1"
																/>
															))}
														</g>
													)}
												</svg>
											)}
											{aligned && (
												<ol class="mark-list" aria-label="题铭">
													{detail.marks.map((mark, markIndex) => (
														<li
															id={`${record.id}-${detailDomKey(detail)}-mark-${mark.id}`}
															data-mark-id={mark.id}
															data-index={markIndex}
															data-side={paintSide(mark.side)}
															data-side-pref={mark.side}
															data-badge={mark.badge}
															data-x={mark.x}
															data-y={mark.y}
															data-w={mark.w}
															data-h={mark.h}
														>
															{showMarkLabel(mark) && <p class="mark-label">{mark.label}</p>}
															<p class="mark-note"><span class="mark-index">{noteIndexPrefix(markIndex + 1)}</span> {mark.note}</p>
														</li>
													))}
												</ol>
											)}
										</div>
									</div>
								</div>
							);
						})}
						<div class="split-settled-bar"></div>
					</div>
					</div>
					<div class="split-read">
						<div class="split-read-track">
						<header class="record-tombstone">
							<h1>{record.work}</h1>
							<p class="record-tombstone-meta">
								<span>{record.artist}</span>
								<span aria-hidden="true"> · </span>
								<span>{record.label}</span>
								<span aria-hidden="true"> · </span>
								<span>{record.catalogNumber}</span>
								<span aria-hidden="true"> · </span>
								<span>{when}</span>
								<span class={badgeClass(record.status)}>{record.status}</span>
							</p>
						</header>
						{showDetailsNote(record) && <p class="meta">{record.detailsNote}</p>}
						{revealDetails.map((detail) => {
							const remainder = visibleDetailText(detail);
							return remainder ? <p class="detail-text">{remainder}</p> : null;
						})}
						{nonRevealDetails.length > 0 && (
							<div class="detail-grid">
								{nonRevealDetails.map((detail) => {
									const mode = detailMode(detail);
									const aligned = notesAligned(detail);
									const remainder = visibleDetailText(detail);
									const sides = new Set(detail.marks.map((mark) => paintSide(mark.side)));
									const faceLabel = formatDetailFace(resolveDetailFace(detail));
									return (
										<figure
											class:list={[
												'detail-figure',
												mode === 'reveal' && 'is-reveal',
												mode !== 'legacy' && 'has-stage',
											]}
											data-part={detail.part}
											data-disc={detail.disc}
											data-side={detail.side}
											data-mode={mode}
											data-plate-width={detail.plate.width}
											data-plate-height={detail.plate.height}
											data-notes={aligned ? 'aligned' : 'open'}
										>
