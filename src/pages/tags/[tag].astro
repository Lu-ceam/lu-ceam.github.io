---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, getTags } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return getTags(posts).map(({ tag }) => ({
		params: { tag },
	}));
}

const tag = Astro.params.tag;
if (!tag) {
	throw new Error('缺少标签');
}

const posts = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag));
---

<Base title={`标签：${tag}`} description={`标签「${tag}」下的文章。`}>
	<h1>标签：{tag}</h1>
	<p class="meta">{posts.length} 篇</p>
	<PostList posts={posts} />
</Base>
