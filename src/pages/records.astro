---
import Base from '../layouts/Base.astro';
import {
	badgeClass,
	records,
	recordSearchText,
	statusBucket,
	uniqueValues,
} from '../data/records';
import type { StatusBucket } from '../data/records';

/** Stated size of the collection being photographed, not a count of entries. */
const catalogTarget = 101;
const composers = uniqueValues(records.map((record) => record.composer));
const artists = uniqueValues(records.map((record) => record.artist));
const labels = uniqueValues(records.map((record) => record.label));
const decades = uniqueValues(records.map((record) => record.decade));

function count(bucket: StatusBucket): number {
	return records.filter((record) => statusBucket(record.status) === bucket).length;
}

const verified = count('verified');
const partial = count('partial');
const review = count('review');
const unchecked = count('unchecked');
const hasTrajectory = records.some((record) => record.trajectory);
---

<Base
	title="黑胶藏品目录"
	description="只收录已有照片的黑胶压片。对照资料核实，不估价。状态标出已核与待核。"
	wide
>
	<div class="catalog-page" data-records>
		<h1>黑胶藏品目录</h1>
		<p class="lede">
			只收录已经有照片的压片；对照 Discogs / 厂牌资料逐张核实，状态标出已核与待核。不估价，签名只记笔迹。
		</p>
		{
			hasTrajectory && (
				<p class="catalog-map-link">
					<a href="/records/map/">时空轨迹</a>
				</p>
			)
		}
		{
			records.length === 0 ? (
				<p class="empty-state">藏品整理中</p>
			) : (
				<>
					<section aria-labelledby="progress-heading">
						<h2 id="progress-heading">进度</h2>
						<p>
							目标约 {catalogTarget} 张。现在录入的都是已经有照片的压片，其余等照片齐了再写。核实状态见各条目。
						</p>
						<div
							class="progress-track"
							role="progressbar"
							aria-valuemin={0}
							aria-valuemax={catalogTarget}
							aria-valuenow={records.length}
							aria-label={`已录入 ${records.length} / ${catalogTarget}`}
						>
							<div
								class="progress-fill"
								style={`width: ${Math.min(100, (records.length / catalogTarget) * 100)}%`}
							/>
						</div>
						<ul class="progress-stats">
							<li>
								<strong>
									{records.length} / {catalogTarget}
								</strong>
								<span>已录入</span>
							</li>
							<li>
								<strong>
									{verified} / {catalogTarget}
								</strong>
								<span>已核</span>
							</li>
							<li>
								<strong>{partial}</strong>
								<span>大体已核</span>
							</li>
							<li>
								<strong>{review}</strong>
								<span>待复核</span>
							</li>
							<li>
								<strong>{unchecked}</strong>
								<span>待核</span>
							</li>
						</ul>
						<aside class="catalog-note">
							<p class="catalog-note-label">记事</p>
							<p>未查到 · 未记录 · 推测。品相有的来自照片估或口述，并不都是 Goldmine 分级。</p>
						</aside>
					</section>

					<section aria-labelledby="filter-heading">
						<h2 id="filter-heading">筛选</h2>
						<form class="filters filters-catalog" action="/records/" method="get">
							<div class="filter filter-composer">
								<label for="record-composer">作曲家</label>
								<select id="record-composer" name="composer">
									<option value="">全部</option>
									{composers.map((composer) => (
										<option value={composer}>{composer}</option>
									))}
								</select>
							</div>
							<div class="filter filter-artist">
								<label for="record-artist">演奏者 / 指挥</label>
								<select id="record-artist" name="artist">
									<option value="">全部</option>
									{artists.map((artist) => (
										<option value={artist}>{artist}</option>
									))}
								</select>
							</div>
							<div class="filter filter-label">
								<label for="record-label">厂牌</label>
								<select id="record-label" name="label">
									<option value="">全部</option>
									{labels.map((label) => (
										<option value={label}>{label}</option>
									))}
								</select>
							</div>
							<div class="filter filter-decade">
								<label for="record-decade">年代</label>
								<select id="record-decade" name="decade">
									<option value="">全部</option>
									{decades.map((decade) => (
										<option value={decade}>{decade}</option>
									))}
								</select>
							</div>
							<div class="filter filter-status">
								<label for="record-status">核实状态</label>
								<select id="record-status" name="status">
									<option value="">全部</option>
									<option value="verified">已核</option>
									<option value="partial">大体已核</option>
									<option value="review">待复核</option>
									<option value="unchecked">待核</option>
								</select>
							</div>
							<div class="filter filter-text">
								<label for="record-q">搜索</label>
								<input
									id="record-q"
									name="q"
									type="search"
									placeholder="目录号、作品、艺人"
									autocomplete="off"
								/>
							</div>
							<div class="filter-actions">
								<button type="button" id="record-reset">重置</button>
							</div>
						</form>
					</section>

					<section aria-labelledby="catalog-heading">
						<h2 id="catalog-heading">
							目录 · <span id="catalog-count">{records.length}</span>
						</h2>
						<p id="records-no-match" class="empty-state" hidden>
							没有符合条件的藏品。
						</p>
						<div class="catalog">
							<div class="catalog-head" aria-hidden="true">
								<span class="c-cat">目录号</span>
								<span class="c-status">状态</span>
								<span class="c-work">作品</span>
								<span class="c-meta">演奏者 · 厂牌 · 年代</span>
							</div>
							{
								records.map((record) => (
									<a
										class="catalog-item"
										id={record.id}
										href={`/records/${record.id}/`}
										data-record
										data-status={statusBucket(record.status)}
										data-composer={record.composer}
										data-artist={record.artist}
										data-label={record.label}
										data-decade={record.decade}
										data-search={recordSearchText(record)}
									>
										<img
											class="c-cover"
											src={record.image.src}
											width="96"
											height="96"
											alt=""
											decoding="async"
											loading="lazy"
										/>
										<span class="c-text">
											<span class="c-cat">{record.catalogNumber}</span>
											<span class="c-status">
												<span class={badgeClass(record.status)}>{record.status}</span>
											</span>
											<span class="c-work">{record.work}</span>
											<span class="c-meta">
												<span class="c-artist">{record.artist}</span>
												<span class="c-sub">
													<span class="c-label">{record.label}</span>
													<span class="c-decade">{record.year ?? record.decade}</span>
												</span>
											</span>
										</span>
									</a>
								))
							}
						</div>
						<p class="hint">不启用 JavaScript 时会显示全部藏品。点一行打开该压片的单独页面。筛选在浏览器里即时生效。</p>
					</section>
					<script is:inline>
						(function () {
							var root = document.querySelector('[data-records]');
							if (!root) return;
							var queryInput = root.querySelector('#record-q');
							var composerInput = root.querySelector('#record-composer');
							var artistInput = root.querySelector('#record-artist');
							var labelInput = root.querySelector('#record-label');
							var decadeInput = root.querySelector('#record-decade');
							var statusInput = root.querySelector('#record-status');
							var resetButton = root.querySelector('#record-reset');
							var items = Array.prototype.slice.call(root.querySelectorAll('[data-record]'));
							var empty = root.querySelector('#records-no-match');
							var count = root.querySelector('#catalog-count');
							var head = root.querySelector('.catalog-head');

							function norm(value) {
								return value.toLocaleLowerCase('zh-CN').trim();
							}

							function selected(element) {
								return element instanceof HTMLSelectElement ? element.value : '';
							}

							function apply() {
								var query = queryInput instanceof HTMLInputElement ? norm(queryInput.value) : '';
								var composer = selected(composerInput);
								var artist = selected(artistInput);
								var label = selected(labelInput);
								var decade = selected(decadeInput);
								var status = selected(statusInput);
								var visible = 0;
								items.forEach(function (item) {
									var haystack = item.getAttribute('data-search') || '';
									var match =
										(query === '' || haystack.indexOf(query) !== -1) &&
										(composer === '' || item.getAttribute('data-composer') === composer) &&
										(artist === '' || item.getAttribute('data-artist') === artist) &&
										(label === '' || item.getAttribute('data-label') === label) &&
										(decade === '' || item.getAttribute('data-decade') === decade) &&
										(status === '' || item.getAttribute('data-status') === status);
									item.hidden = !match;
									if (match) visible += 1;
								});
								if (empty) empty.hidden = visible !== 0;
								if (head) head.hidden = visible === 0;
								if (count) count.textContent = String(visible);
							}

							function openHash() {
								if (!location.hash) return;
								var id = '';
								try {
									id = decodeURIComponent(location.hash.slice(1));
								} catch (error) {
									return;
								}
								if (!/^[a-z0-9]+$/.test(id)) return;
								var entry = document.getElementById(id);
								if (entry && entry.getAttribute('data-record') !== null) {
									location.replace('/records/' + id + '/');
								}
							}

							root.addEventListener('input', apply);
							root.addEventListener('change', apply);
							if (resetButton) {
								resetButton.addEventListener('click', function () {
									var form = resetButton.form;
									if (form) form.reset();
									apply();
								});
							}
							var form = root.querySelector('form');
							if (form) {
								form.addEventListener('submit', function (event) {
									event.preventDefault();
									apply();
								});
							}
							openHash();
							apply();
						})();
					</script>
				</>
			)
		}
	</div>
</Base>
