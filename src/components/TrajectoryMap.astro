---
import 'leaflet/dist/leaflet.css';
import type { TrajectoryPlace } from '../data/records-export';
import { roleLabel, yearText } from '../data/trajectory-camera';
import { dedupedStationCount } from '../data/trajectory-chrono';
import { yearRailOffset, yearRailPins } from '../data/disc-chapters';

export interface TrajectoryDisc {
	id: string;
	href: string;
	work: string;
	catalogNumber: string;
	titleZh: string;
	places: TrajectoryPlace[];
}

interface Props {
	mode: 'embed' | 'overview';
	discs: TrajectoryDisc[];
}

const { mode, discs } = Astro.props;
const headingId = mode === 'embed' ? `traj-${discs[0]?.id ?? 'record'}` : 'traj-overview';
const payload = JSON.stringify({ mode, discs }).replace(/</g, '\\u003c');
const firstDisc = discs[0];
const first = firstDisc?.places[0];
const stopCount = firstDisc?.places.length ?? 0;
const catalogCount = dedupedStationCount(
	discs.flatMap((disc) =>
		disc.places.map((place) => ({
			city: place.city,
			lon: place.lon,
			lat: place.lat,
			...(place.eventId ? { eventId: place.eventId } : {}),
		})),
	),
);
const mapCount = mode === 'overview' ? catalogCount : stopCount;
const indexLabel = `01 / ${String(stopCount).padStart(2, '0')}`;
const railStops =
	mode === 'embed' && firstDisc
		? firstDisc.places
				.map((place, index) => ({ place, index }))
				.sort((a, b) => a.place.year - b.place.year || a.index - b.index)
		: [];
const railMin = railStops[0]?.place.year ?? 0;
const railMax = railStops[railStops.length - 1]?.place.year ?? railMin;
const railSpan = railMax - railMin;
/** 窄屏主进度：左侧纵年轴，年距按真实年份比例（与图下横轴同语法，只是轴向改竖）。 */
const yearPins =
	mode === 'embed' && firstDisc
		? yearRailPins(firstDisc.places.map((place) => ({ id: place.id, year: place.year })))
		: [];
---

<section
	class:list={['traj', mode === 'overview' && 'traj--overview']}
	data-traj-root
	data-payload={payload}
	aria-labelledby={headingId}
>
	{
		mode === 'embed' ? (
			<h2 id={headingId} class="traj-title">
				{firstDisc?.titleZh ?? '时空轨迹'}
			</h2>
		) : (
			<h2 id={headingId} class="traj-overview-label">
				轨迹
			</h2>
		)
	}
	<p class="traj-note">旁注标明示意或待核定的，不当定论。压片在核到城市之前只标国家，不标厂址。</p>
	<div class="traj-stage">
		{
			mode === 'embed' && yearPins.length > 0 && (
				<div class="traj-year-rail" data-traj-year-rail aria-hidden="true">
					<div class="traj-year-axis">
						<ol class="traj-year-pins">
							{yearPins.map((pin, position) => (
								<li
									class:list={[position === 0 && 'is-on']}
									style={`--pin-t: ${yearRailOffset(pin)}`}
								>
									<button
										type="button"
										tabindex="-1"
										data-traj-place={pin.id}
										data-disc={firstDisc?.id}
									>
										<span class="traj-year-dot"></span>
										<span class="traj-year-y">{pin.label ?? ''}</span>
									</button>
								</li>
							))}
						</ol>
					</div>
				</div>
			)
		}
		<div class="traj-map-wrap">
			<p class="traj-fallback" data-traj-fallback>地图底图需要脚本。下方的旁白和站点列表仍可阅读。</p>
			<div class="traj-map" data-traj-map aria-label={`${mapCount} 个地点的轨迹地图`}></div>
			<div class="traj-rail" data-traj-rail aria-hidden="true" hidden={mode === 'overview'}>
				<div class="traj-rail-track">
					<div class="traj-rail-inner">
						<svg class="traj-rail-ticks"></svg>
						<ol class="traj-rail-pins">
							{
								railStops.map((stop, position) => {
									const prev = railStops[position - 1];
									const showYear = !prev || prev.place.year !== stop.place.year;
									const t = railSpan <= 0 ? 0.5 : (stop.place.year - railMin) / railSpan;
									const on = stop.index === 0;
									return (
										<li class:list={[on && 'is-on', on && 'is-done']}>
											<button
												type="button"
												tabindex="-1"
												data-traj-place={stop.place.id}
												data-disc={firstDisc?.id}
												data-rail-index={stop.index}
												style={`left:calc(var(--rail-pad) + (100% - 2 * var(--rail-pad)) * ${t})`}
											>
												<span class="traj-rail-dot"></span>
												<span class="traj-rail-y">{showYear ? stop.place.year : ''}</span>
											</button>
										</li>
									);
								})
							}
						</ol>
					</div>
				</div>
			</div>
		</div>
		<div class="traj-narr">
			{
				mode === 'overview' && (
					<div class="traj-disc-head">
						<p class="traj-disc-work" data-traj-work>
							全馆
						</p>
						<p class="traj-disc-link">
							<a data-traj-open hidden href={firstDisc?.href ?? '/records/'}>
								{firstDisc ? `打开 ${firstDisc.catalogNumber}` : ''}
							</a>
						</p>
					</div>
				)
			}
			<div class="traj-card" data-traj-card aria-live="polite">
				{
					mode === 'overview' ? (
						<>
							<p class="traj-meta">
								<span class="traj-idx" data-traj-idx />
								<span data-traj-meta>全馆 · {catalogCount} 站</span>
							</p>
							<h3 class="traj-city" data-traj-city>点选站点或一张唱片</h3>
							<p class="traj-en" data-traj-en />
							<p class="traj-blurb" data-traj-blurb hidden />
						</>
					) : (
						first && (
							<>
								<p class="traj-meta">
									<span class="traj-idx" data-traj-idx>
										{indexLabel}
									</span>
									<span data-traj-meta>
										{yearText(first)} · {roleLabel(first.role)}
									</span>
								</p>
								<h3 class="traj-city" data-traj-city>
									{first.cityZh}
								</h3>
								<p class="traj-en" data-traj-en>
									{first.city}
								</p>
								<p class="traj-blurb" data-traj-blurb hidden={!first.blurb}>
									{first.blurb}
								</p>
							</>
						)
					)
				}
				<p class="traj-bearing" data-traj-bearing hidden></p>
			</div>
			<div class="traj-controls">
				<button type="button" data-traj-guide aria-pressed={mode === 'embed' ? 'true' : 'false'}>导览</button>
				<button type="button" data-traj-chrono aria-pressed="false">游线</button>
				<button type="button" data-traj-explore aria-pressed={mode === 'overview' ? 'true' : 'false'}>
					{mode === 'overview' ? '回到导播' : '探索'}
				</button>
				<button type="button" data-traj-play aria-pressed="false">▶ 播放</button>
				<button type="button" data-traj-replay>↺ 重播</button>
				<span class="traj-controls-sp"></span>
				<span class="traj-nav-pair">
					<button type="button" class="traj-nav" data-traj-prev aria-label="上一站">‹</button>
					<button type="button" class="traj-nav" data-traj-next aria-label="下一站">›</button>
				</span>
			</div>
			{
				mode === 'overview' && discs.length > 0 && (
					<ul class="traj-switch">
						<li>
							<button type="button" data-traj-all aria-pressed="true">
								全馆
							</button>
						</li>
						{discs.map((disc) => (
							<li>
								<button type="button" data-traj-switch={disc.id} aria-pressed="false">
									{disc.catalogNumber}
								</button>
							</li>
						))}
					</ul>
				)
			}
			{
				discs.map((disc, discIndex) => (
					<div data-traj-disc-panel={disc.id} hidden={mode === 'embed' && discIndex > 0}>
						<details class="traj-stops-fold" open>
							<summary>站表 · {disc.places.length} 站</summary>
							<ol class="traj-stops">
								{disc.places.map((place, index) => (
									<li class={mode === 'embed' && discIndex === 0 && index === 0 ? 'is-on' : undefined}>
										<button
											type="button"
											id={`${disc.id}-${place.id}`}
											data-traj-place={place.id}
											data-disc={disc.id}
											aria-current={mode === 'embed' && discIndex === 0 && index === 0 ? 'step' : undefined}
										>
											<span class="y">{yearText(place)}</span>
											<span class="c">
												{place.cityZh} · {roleLabel(place.role)}
											</span>
											{place.blurb && <span class="traj-stop-blurb">{place.blurb}</span>}
										</button>
									</li>
								))}
							</ol>
						</details>
					</div>
				))
			}
		</div>
	</div>
	{
		mode === 'overview' && (
			<ul class="traj-legend" aria-label="图例">
				<li>
					<span class="traj-swatch" aria-hidden="true"></span>路径
				</li>
				<li>
					<span class="traj-swatch traj-swatch--weak" aria-hidden="true"></span>跨碟弱连
				</li>
			</ul>
		)
	}
	<p class="traj-credit">
		Made with <a href="https://www.naturalearthdata.com/">Natural Earth</a>。底图为本地 1:50m
		陆地与国界，运行时不请求远程瓦片。城市级精度，不作街道定位。
	</p>
	{
		mode === 'embed' && (
			<p class="traj-more">
				<a href="/records/map/">查看全部唱片的时空轨迹</a>
			</p>
		)
	}
</section>

<script>
	import { mountTrajectoryMaps } from './trajectory-map-client';

	mountTrajectoryMaps();
</script>

<style>
	.traj {
		--paper: #f5f1e8;
		--ocean: #e9eef0;
		--land: #f7f3ea;
		--ink: #2b2722;
		--traj-muted: #7b7266;
		--traj-accent: #a8432b;
		--traj-line: #e3dccd;
		/* Teardrop pin: engraved at rest, relief when active. */
		--traj-pin-brick: #B85C38;
		--traj-pin-paper: #FFF8F2;
		--traj-pin-rest-fill: transparent;
		--traj-pin-rest-stroke: var(--traj-pin-brick);
		--traj-pin-rest-weight: 2;
		--traj-pin-active-fill: var(--traj-pin-brick);
		--traj-pin-active-stroke: #9A4A2C;
		--traj-pin-active-weight: 1.2;
		--traj-pin-active-glyph: var(--traj-pin-paper);
		--traj-pin-transition: 200ms ease;
		--traj-pin-pop-ms: 180ms;
		--traj-pin-head-glyph-y: 35%;
		--serif: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', 'STSong', Georgia, serif;
		--rail-pin: var(--traj-accent);
		--rail-pin-ring: #ffffff;
		--rail-pin-d: 7px;
		--rail-pin-d-on: 11px;
		--rail-pin-ring-w: 1.2px;
		--rail-pin-ring-w-on: 1.6px;
		--rail-pending-opacity: 0.45;
		--rail-visited-opacity: 1;
		--rail-line-rest: rgba(168, 67, 43, 0.32);
		--rail-line-done: rgba(168, 67, 43, 0.9);
		--rail-tick: rgba(143, 133, 113, 0.55);
		--rail-year-size: 11px;
		--rail-century-size: 10px;
		--rail-gap: 32px;
		--rail-pad: 16px;
		--rail-h: 56px;
		--rail-chrono-scale: 1.15;
		--rail-chrono-visited-opacity: 0.7;
		--rail-pencil: #8f8571;
		margin-top: 2.5rem;
		color: var(--ink);
		background: var(--paper);
	}

	.traj-overview-label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.traj-title {
		font-family: var(--serif);
		font-weight: 600;
		font-size: 22px;
		line-height: 1.3;
		letter-spacing: 0.02em;
		margin: 0 0 14px;
	}

	.traj-note,
	.traj-credit {
		color: var(--traj-muted);
		font-size: 12px;
		line-height: 1.6;
	}

	.traj-note {
		max-width: 42em;
		margin: 0 0 14px;
	}

	.traj-stage {
		display: flex;
		flex-direction: column;
	}

	/*
	 * Guide and playback hold the vertical gesture on the stage: the page must not
	 * move first while a station is stepping. The open stop list and its summary
	 * keep their own scroll, so a long list is still a list.
	 */
	.traj-stage.is-guide-lock {
		touch-action: none;
		overscroll-behavior-y: contain;
	}

	.traj-stage.is-guide-lock .traj-stops,
	.traj-stage.is-guide-lock .traj-stops-fold > summary {
		touch-action: pan-y;
		overscroll-behavior-y: contain;
	}

	.traj-map-wrap,
	.traj-narr {
		min-width: 0;
	}

	/* 左纵年轴：窄屏主进度（桌面不显示，桌面照旧用图下横轴）。 */
	.traj .traj-year-rail {
		display: none;
	}

	.traj .traj-year-axis {
		position: relative;
		height: 100%;
		min-height: 11rem;
	}

	.traj .traj-year-axis::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 6%;
		bottom: 6%;
		width: 1px;
		transform: translateX(-50%);
		background: var(--rail-line-rest);
	}

	.traj .traj-year-pins {
		list-style: none;
		margin: 0;
		padding: 0;
		position: absolute;
		inset: 0;
	}

	.traj .traj-year-pins li {
		position: absolute;
		left: 0;
		right: 0;
		top: var(--pin-t, 50%);
		transform: translateY(-50%);
	}

	.traj .traj-year-pins button {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.1rem;
		width: 100%;
		/* P2-B：真实 button 盒 ≥44×44（年份／站点／轨迹不变，只补热区）。 */
		min-width: 44px;
		min-height: 44px;
		padding: 0.1rem 0;
		border: 0;
		background: none;
		color: var(--traj-muted);
		font-size: var(--rail-year-size);
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
		cursor: pointer;
	}

	.traj .traj-year-dot {
		width: var(--rail-pin-d);
		height: var(--rail-pin-d);
		border-radius: 50%;
		border: var(--rail-pin-ring-w) solid var(--rail-pin);
		background: var(--rail-pin-ring);
		transition: transform var(--traj-pin-transition), background var(--traj-pin-transition);
	}

	.traj .traj-year-pins li.is-on button {
		color: var(--traj-accent);
	}

	.traj .traj-year-pins li.is-on .traj-year-dot {
		width: var(--rail-pin-d-on);
		height: var(--rail-pin-d-on);
		background: var(--rail-pin);
	}

	@media (max-width: 47.99rem) {
		.traj .traj-stage {
			display: grid;
			grid-template-columns: var(--disc-year-rail-w, 44px) minmax(0, 1fr);
			/* 图占自身高度，旁白拿剩下的：控件不会被裁出屏外。 */
			grid-template-rows: auto minmax(0, 1fr);
			align-items: stretch;
		}

		.traj .traj-year-rail {
			display: block;
			grid-column: 1;
			grid-row: 1 / span 2;
			min-width: var(--disc-year-rail-w, 44px);
			/* P2-B：矮屏装不下时整条年轨纵向可滚，不压缩热区、不叠年号。 */
			overflow-x: hidden;
			overflow-y: auto;
			overscroll-behavior-y: contain;
			scrollbar-width: none;
			border-right: 1px solid var(--traj-line);
		}

		.traj .traj-year-rail::-webkit-scrollbar {
			display: none;
		}

		.traj .traj-map-wrap,
		.traj .traj-narr {
			grid-column: 2;
			min-height: 0;
		}

		/* 窄屏：图下横年轴不再当主进度（进度在左纵轴）。 */
		.traj .traj-rail {
			display: none;
		}
	}

	.traj-map-wrap {
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid #d8d0c0;
	}

	.traj-fallback {
		margin: 0.65rem 0;
		color: var(--traj-muted);
		font-size: 13px;
	}

	.traj-fallback[hidden] {
		display: none;
	}

	.traj-map {
		height: min(58vh, 520px);
		min-height: 280px;
		background: var(--ocean);
		z-index: 0;
		touch-action: pan-y;
	}

	.traj-map:not(.is-explore) {
		touch-action: pan-x !important;
	}

	.traj-map.is-explore {
		touch-action: none;
	}

	.traj-narr {
		padding: 14px 2px 6px;
	}

	.traj-disc-work {
		margin: 0;
		font-family: var(--serif);
		font-size: 16px;
		font-weight: 600;
		line-height: 1.35;
	}

	.traj-disc-link {
		margin: 0 0 10px;
		font-size: 13px;
	}

	.traj-disc-link a,
	.traj-more a,
	.traj-credit a {
		color: var(--traj-accent);
	}

	.traj-card {
		min-height: 148px;
		transition: opacity 0.45s ease, transform 0.45s ease;
	}

	.traj-card.is-out {
		opacity: 0;
		transform: translateY(6px);
	}

	/*
	 * Phone (≤640): the sheet takes about four tenths of the screen and the card
	 * a compact block, so the city name and two lines of narration stay in the
	 * first view under the year rail. Wider screens keep the taller sheet.
	 */
	@media (max-width: 640px) {
		.traj-map {
			height: min(42vh, 320px);
			min-height: 220px;
		}

		.traj-narr {
			padding: 10px 2px 4px;
		}

		.traj-card {
			min-height: 112px;
		}
	}

	.traj-meta {
		font-size: 12px;
		letter-spacing: 0.12em;
		color: var(--traj-accent);
		margin: 0 0 4px;
		font-variant-numeric: tabular-nums;
	}

	.traj-idx {
		color: var(--traj-muted);
		margin-right: 8px;
	}

	.traj-city {
		font-family: var(--serif);
		font-size: 26px;
		line-height: 1.2;
		margin: 0 0 2px;
		font-weight: 600;
	}

	.traj-en {
		font-size: 12px;
		color: var(--traj-muted);
		letter-spacing: 0.06em;
		margin: 0 0 10px;
	}

	.traj-blurb {
		font-family: var(--serif);
		font-size: 15px;
		line-height: 1.75;
		margin: 0;
		color: #3a352e;
		max-width: 36em;
	}

	.traj-blurb[hidden] {
		display: none;
	}

	.traj-bearing {
		margin: 0;
		font-family: var(--serif);
		font-size: 15px;
		line-height: 1.75;
		letter-spacing: 0.12em;
		color: var(--traj-muted);
	}

	.traj-card.is-bearing .traj-bearing:not([hidden]) {
		display: block;
	}

	.traj-card.is-bearing .traj-meta,
	.traj-card.is-bearing .traj-city,
	.traj-card.is-bearing .traj-en,
	.traj-card.is-bearing .traj-blurb {
		display: none;
	}

	.traj-controls {
		display: flex;
		gap: 8px;
		align-items: center;
		padding: 10px 0 4px;
		border-top: 1px solid var(--traj-line);
		margin-top: 12px;
		flex-wrap: wrap;
	}

	.traj-controls-sp {
		flex: 1;
	}

	.traj-controls button,
	.traj-switch button {
		appearance: none;
		border: 1px solid #cfc6b5;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 13px;
		padding: 7px 12px;
		border-radius: 999px;
		cursor: pointer;
		min-height: 36px;
	}

	.traj-controls button {
		min-height: 44px;
		padding: 10px 14px;
	}

	.traj-controls button[aria-pressed='true'],
	.traj-switch button[aria-pressed='true'] {
		background: var(--ink);
		color: var(--paper);
		border-color: var(--ink);
	}

	.traj-switch {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		list-style: none;
		margin: 12px 0 0;
		padding: 0;
	}

	.traj-stops {
		list-style: none;
		margin: 18px 0 0;
		padding: 0;
		border-top: 1px solid var(--traj-line);
	}

	.traj-stops-fold > summary {
