---
import 'leaflet/dist/leaflet.css';
import type { TrajectoryPlace } from '../data/records-export';
import { roleLabel, yearText } from '../data/trajectory-camera';

export interface TrajectoryDisc {
	id: string;
	href: string;
	work: string;
	catalogNumber: string;
	titleZh: string;
	places: TrajectoryPlace[];
}

interface Props {
	mode: 'embed' | 'overview';
	discs: TrajectoryDisc[];
}

const { mode, discs } = Astro.props;
const headingId = mode === 'embed' ? `traj-${discs[0]?.id ?? 'record'}` : 'traj-overview';
const payload = JSON.stringify({ mode, discs }).replace(/</g, '\\u003c');
const firstDisc = discs[0];
const first = firstDisc?.places[0];
const stopCount = firstDisc?.places.length ?? 0;
const indexLabel = `01 / ${String(stopCount).padStart(2, '0')}`;
---

<section
	class:list={['traj', mode === 'overview' && 'traj--overview']}
	data-traj-root
	data-payload={payload}
	aria-labelledby={headingId}
>
	{
		mode === 'embed' ? (
			<h2 id={headingId} class="traj-title">
				{firstDisc?.titleZh ?? '时空轨迹'}
			</h2>
		) : (
			<h2 id={headingId} class="traj-overview-label">
				轨迹
			</h2>
		)
	}
	<p class="traj-note">旁注标明示意或待核定的，不当定论。压片在核到城市之前只标国家，不标厂址。</p>
	<div class="traj-stage">
		<div class="traj-map-wrap">
			<p class="traj-fallback" data-traj-fallback>地图底图需要脚本。下方的旁白和站点列表仍可阅读。</p>
			<div class="traj-map" data-traj-map aria-label={`${stopCount} 个地点的轨迹地图`}></div>
		</div>
		<div class="traj-narr">
			{
				mode === 'overview' && firstDisc && (
					<div class="traj-disc-head">
						<p class="traj-disc-work" data-traj-work>
							{firstDisc.work}
						</p>
						<p class="traj-disc-link">
							<a data-traj-open href={firstDisc.href}>
								打开 {firstDisc.catalogNumber}
							</a>
						</p>
					</div>
				)
			}
			<div class="traj-progress" data-traj-progress aria-hidden="true">
				{
					firstDisc?.places.map((_, index) => (
						<span class={index === 0 ? 'is-cur' : undefined}>
							<i></i>
						</span>
					))
				}
			</div>
			<div class="traj-card" data-traj-card aria-live="polite">
				{
					first && (
						<>
							<p class="traj-meta">
								<span class="traj-idx" data-traj-idx>
									{indexLabel}
								</span>
								<span data-traj-meta>
									{yearText(first)} · {roleLabel(first.role)}
								</span>
							</p>
							<h3 class="traj-city" data-traj-city>
								{first.cityZh}
							</h3>
							<p class="traj-en" data-traj-en>
								{first.city}
							</p>
							<p class="traj-blurb" data-traj-blurb hidden={!first.blurb}>
								{first.blurb}
							</p>
						</>
					)
				}
				<p class="traj-bearing" data-traj-bearing hidden></p>
			</div>
			<div class="traj-controls">
				<button type="button" data-traj-play aria-pressed="false">▶ 播放</button>
				<button type="button" data-traj-replay>↺ 重播</button>
				<span class="traj-controls-sp"></span>
				<button type="button" class="traj-nav" data-traj-prev aria-label="上一站">‹</button>
				<button type="button" class="traj-nav" data-traj-next aria-label="下一站">›</button>
				<button type="button" data-traj-explore aria-pressed="false">探索</button>
			</div>
			{
				mode === 'overview' && discs.length > 1 && (
					<ul class="traj-switch">
						{discs.map((disc, discIndex) => (
							<li>
								<button type="button" data-traj-switch={disc.id} aria-pressed={discIndex === 0 ? 'true' : 'false'}>
									{disc.catalogNumber}
								</button>
							</li>
						))}
					</ul>
				)
			}
			{
				discs.map((disc, discIndex) => (
					<div data-traj-disc-panel={disc.id} hidden={discIndex > 0}>
						<ol class="traj-stops">
							{disc.places.map((place, index) => (
								<li class={discIndex === 0 && index === 0 ? 'is-on' : undefined}>
									<button
										type="button"
										id={`${disc.id}-${place.id}`}
										data-traj-place={place.id}
										data-disc={disc.id}
										aria-current={discIndex === 0 && index === 0 ? 'step' : undefined}
									>
										<span class="y">{yearText(place)}</span>
										<span class="c">
											{place.cityZh} · {roleLabel(place.role)}
										</span>
										{place.blurb && <span class="traj-stop-blurb">{place.blurb}</span>}
									</button>
								</li>
							))}
						</ol>
					</div>
				))
			}
		</div>
	</div>
	{
		mode === 'overview' && (
			<ul class="traj-legend" aria-label="图例">
				<li>
					<span class="traj-swatch" aria-hidden="true"></span>路径
				</li>
				<li>
					<span class="traj-swatch traj-swatch--weak" aria-hidden="true"></span>跨碟弱连
				</li>
			</ul>
		)
	}
	<p class="traj-credit">
		Made with <a href="https://www.naturalearthdata.com/">Natural Earth</a>。底图为本地 1:50m
		陆地与国界，运行时不请求远程瓦片。城市级精度，不作街道定位。
	</p>
	{
		mode === 'embed' && (
			<p class="traj-more">
				<a href="/records/map/">查看全部唱片的时空轨迹</a>
			</p>
		)
	}
</section>

<script>
	import { mountTrajectoryMaps } from './trajectory-map-client';

	mountTrajectoryMaps();
</script>

<style>
	.traj {
		--paper: #f5f1e8;
		--ocean: #e9eef0;
		--land: #f7f3ea;
		--ink: #2b2722;
		--traj-muted: #7b7266;
		--traj-accent: #a8432b;
		--traj-line: #e3dccd;
		--serif: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', 'STSong', Georgia, serif;
		margin-top: 2.5rem;
		color: var(--ink);
		background: var(--paper);
	}

	.traj-overview-label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.traj-title {
		font-family: var(--serif);
		font-weight: 600;
		font-size: 22px;
		line-height: 1.3;
		letter-spacing: 0.02em;
		margin: 0 0 14px;
	}

	.traj-note,
	.traj-credit {
		color: var(--traj-muted);
		font-size: 12px;
		line-height: 1.6;
	}

	.traj-note {
		max-width: 42em;
		margin: 0 0 14px;
	}

	.traj-stage {
		display: flex;
		flex-direction: column;
	}

	.traj-map-wrap,
	.traj-narr {
		min-width: 0;
	}

	.traj-map-wrap {
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid #d8d0c0;
	}

	.traj-fallback {
		margin: 0.65rem 0;
		color: var(--traj-muted);
		font-size: 13px;
	}

	.traj-fallback[hidden] {
		display: none;
	}

	.traj-map {
		height: min(58vh, 520px);
		min-height: 280px;
		background: var(--ocean);
		z-index: 0;
		touch-action: pan-y;
	}

	.traj-map:not(.is-explore) {
		touch-action: pan-y !important;
	}

	.traj-map.is-explore {
		touch-action: none;
	}

	.traj-narr {
		padding: 14px 2px 6px;
	}

	.traj-disc-work {
		margin: 0;
		font-family: var(--serif);
		font-size: 16px;
		font-weight: 600;
		line-height: 1.35;
	}

	.traj-disc-link {
		margin: 0 0 10px;
		font-size: 13px;
	}

	.traj-disc-link a,
	.traj-more a,
	.traj-credit a {
		color: var(--traj-accent);
	}

	.traj-progress {
		display: flex;
		gap: 6px;
		margin: 0 0 12px;
	}

	.traj-progress span {
		flex: 1;
		height: 2px;
		background: #ddd5c5;
		position: relative;
		overflow: hidden;
	}

	.traj-progress span i {
		position: absolute;
		inset: 0;
		background: var(--traj-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.5s;
	}

	.traj-progress span.is-done i {
		transform: scaleX(1);
	}

	.traj-progress span.is-cur i {
		transform: scaleX(1);
		opacity: 0.55;
	}

	.traj-card {
		min-height: 148px;
		transition: opacity 0.45s ease, transform 0.45s ease;
	}

	.traj-card.is-out {
		opacity: 0;
		transform: translateY(6px);
	}

	.traj-meta {
		font-size: 12px;
		letter-spacing: 0.12em;
		color: var(--traj-accent);
		margin: 0 0 4px;
		font-variant-numeric: tabular-nums;
	}

	.traj-idx {
		color: var(--traj-muted);
		margin-right: 8px;
	}

	.traj-city {
		font-family: var(--serif);
		font-size: 26px;
		line-height: 1.2;
		margin: 0 0 2px;
		font-weight: 600;
	}

	.traj-en {
		font-size: 12px;
		color: var(--traj-muted);
		letter-spacing: 0.06em;
		margin: 0 0 10px;
	}

	.traj-blurb {
		font-family: var(--serif);
		font-size: 15px;
		line-height: 1.75;
		margin: 0;
		color: #3a352e;
		max-width: 36em;
		overflow: hidden;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.traj-blurb[hidden] {
		display: none;
	}

	.traj-bearing {
		margin: 0;
		font-family: var(--serif);
		font-size: 15px;
		line-height: 1.75;
		letter-spacing: 0.12em;
		color: var(--traj-muted);
	}

	.traj-card.is-bearing .traj-bearing:not([hidden]) {
		display: block;
	}

	.traj-card.is-bearing .traj-meta,
	.traj-card.is-bearing .traj-city,
	.traj-card.is-bearing .traj-en,
	.traj-card.is-bearing .traj-blurb {
		display: none;
	}

	.traj-controls {
		display: flex;
		gap: 8px;
		align-items: center;
		padding: 10px 0 4px;
		border-top: 1px solid var(--traj-line);
		margin-top: 12px;
		flex-wrap: wrap;
	}

	.traj-controls-sp {
		flex: 1;
	}

	.traj-controls button,
	.traj-switch button {
		appearance: none;
		border: 1px solid #cfc6b5;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 13px;
		padding: 7px 12px;
		border-radius: 999px;
		cursor: pointer;
		min-height: 36px;
	}

	.traj-controls button {
		min-height: 44px;
		padding: 10px 14px;
	}

	.traj-controls button[aria-pressed='true'],
	.traj-switch button[aria-pressed='true'] {
		background: var(--ink);
		color: var(--paper);
		border-color: var(--ink);
	}

	.traj-switch {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		list-style: none;
		margin: 12px 0 0;
		padding: 0;
	}

	.traj-stops {
		list-style: none;
		margin: 18px 0 0;
		padding: 0;
		border-top: 1px solid var(--traj-line);
	}

	.traj-stops li button {
		appearance: none;
		display: grid;
		grid-template-columns: 4.5em minmax(0, 1fr);
		gap: 10px;
		width: 100%;
		padding: 10px 2px;
		border: 0;
		border-radius: 0;
		border-bottom: 1px solid #eee7da;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
		font: inherit;
		font-size: 14px;
		min-height: 44px;
		text-align: left;
	}

	.traj-stops li button:focus-visible {
		outline: 2px solid var(--traj-accent);
		outline-offset: 2px;
	}

	.traj-stops .y {
		color: var(--traj-muted);
		font-variant-numeric: tabular-nums;
		font-size: 13px;
	}

	.traj-stops li.is-on .c {
		color: var(--traj-accent);
		font-weight: 600;
	}

	.traj-stop-blurb {
		grid-column: 1 / -1;
		color: var(--traj-muted);
		font-size: 13px;
		line-height: 1.55;
		white-space: normal;
	}

	.traj-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		list-style: none;
		margin: 14px 0 0;
		padding: 0;
		color: var(--traj-muted);
		font-size: 12px;
	}

	.traj-swatch {
		display: inline-block;
		width: 2rem;
		margin-right: 0.4rem;
		border-top: 2px solid var(--traj-accent);
		vertical-align: middle;
	}

	.traj-swatch--weak {
		border-top-style: dashed;
		opacity: 0.7;
	}

	.traj-credit,
	.traj-more {
		margin: 12px 0 0;
	}

	@media (min-width: 900px) {
		.traj-title {
			font-size: 28px;
		}

		.traj-stage {
			display: grid;
			grid-template-columns: minmax(0, 1.75fr) minmax(280px, 1fr);
			column-gap: 32px;
			align-items: start;
		}

		.traj-map {
			height: 560px;
		}

		.traj-narr {
			position: sticky;
			top: 24px;
			padding-top: 0;
		}

		.traj-city {
			font-size: 32px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.traj-card,
		.traj-progress span i {
			transition: none;
		}
	}
</style>

<style is:global>
	.traj .leaflet-container {
		font-family: inherit;
		background: #e9eef0;
	}

	.traj .leaflet-control-zoom {
		display: none;
		border: 1px solid #c9bfac !important;
		border-radius: 0 !important;
		box-shadow: none !important;
	}

	.traj .traj-map.is-explore .leaflet-control-zoom {
		display: block;
	}

	.traj .leaflet-control-zoom a {
		width: 36px !important;
		height: 36px !important;
		line-height: 36px !important;
		background: #f5f1e8 !important;
		color: #2b2722 !important;
		border-bottom-color: #c9bfac !important;
	}

	.traj .leaflet-control-attribution {
		background: transparent !important;
		font-size: 9px;
		color: #9a9184;
		max-width: min(70%, 16rem);
	}

	.traj .leaflet-control-attribution a {
		color: #9a9184;
	}

	.traj .leaflet-tooltip.traj-tip {
		background: transparent;
		border: 0;
		box-shadow: none;
		padding: 0;
		font-family: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', 'STSong', Georgia, serif;
		font-size: 12px;
		color: #7b7266;
		text-shadow:
			0 0 2px #f7f3ea,
			0 0 3px #f7f3ea,
			0 0 4px #f7f3ea;
		transition: color 0.4s, font-size 0.4s;
	}

	.traj .leaflet-tooltip.traj-tip::before {
		display: none;
	}

	.traj .leaflet-tooltip.traj-tip.is-hide {
		visibility: hidden;
	}

	.traj .leaflet-tooltip.traj-tip.is-on {
		color: #2b2722;
		font-size: 14px;
		font-weight: 600;
	}

	.traj .traj-pulse-icon {
		background: none;
		border: 0;
	}

	.traj .traj-pulse {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		border: 1.5px solid #a8432b;
		opacity: 0;
		transform: scale(0.4);
	}

	.traj .traj-pulse.is-on {
		animation: traj-pulse-ring 2.4s ease-out infinite;
	}

	@keyframes traj-pulse-ring {
		0% {
			opacity: 0.8;
			transform: scale(0.3);
		}
		100% {
			opacity: 0;
			transform: scale(1.6);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.traj .leaflet-tooltip.traj-tip {
			transition: none;
		}

		.traj .traj-pulse.is-on {
			animation: none;
			opacity: 0.8;
			transform: scale(1);
		}
	}
</style>
